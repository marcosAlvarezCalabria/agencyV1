PUBLIC_WHATSAPP_NUMBER="51984302905"

# Cloudinary Configuration
# Get these values from https://cloudinary.com/console

# Public variable (required in production - add to Netlify env vars)
PUBLIC_CLOUDINARY_CLOUD_NAME="your_cloud_name_here"

# Private variables (only needed for uploading images/videos, NOT for production)
CLOUDINARY_API_KEY="your_api_key_here"
CLOUDINARY_API_SECRET="your_api_secret_here"

# Google Analytics
# Get your tracking ID from https://analytics.google.com/
# Go to Admin > Data Streams > Your web stream > Measurement ID
PUBLIC_GOOGLE_ANALYTICS_ID="G-XXXXXXXXXX"
