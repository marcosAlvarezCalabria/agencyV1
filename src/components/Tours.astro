---
import TourCard from './TourCard.astro';
const { tours, t, lang = 'es' } = Astro.props;
---
<section id="tours" class="py-16 px-4 bg-gray-50">
  <div class="container mx-auto">
    <h2 class="text-4xl font-bold text-center mb-10" style="color: black !important;">{t('tours.title')}</h2>
    
    <!-- Tours Grid con Skeleton -->
    <div 
      id="home-tours-grid"
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8"
    >
      <!-- Skeleton Cards -->
      <div class="home-tour-skeleton">
        <div class="skeleton-image"></div>
        <div class="skeleton-content">
          <div class="skeleton-title"></div>
          <div class="skeleton-price"></div>
          <div class="skeleton-meta"></div>
          <div class="skeleton-description"></div>
          <div class="skeleton-buttons">
            <div class="skeleton-btn"></div>
            <div class="skeleton-btn"></div>
          </div>
        </div>
      </div>
      
      <div class="home-tour-skeleton">
        <div class="skeleton-image"></div>
        <div class="skeleton-content">
          <div class="skeleton-title"></div>
          <div class="skeleton-price"></div>
          <div class="skeleton-meta"></div>
          <div class="skeleton-description"></div>
          <div class="skeleton-buttons">
            <div class="skeleton-btn"></div>
            <div class="skeleton-btn"></div>
          </div>
        </div>
      </div>
      
      <div class="home-tour-skeleton">
        <div class="skeleton-image"></div>
        <div class="skeleton-content">
          <div class="skeleton-title"></div>
          <div class="skeleton-price"></div>
          <div class="skeleton-meta"></div>
          <div class="skeleton-description"></div>
          <div class="skeleton-buttons">
            <div class="skeleton-btn"></div>
            <div class="skeleton-btn"></div>
          </div>
        </div>
      </div>
      
      <div class="home-tour-skeleton">
        <div class="skeleton-image"></div>
        <div class="skeleton-content">
          <div class="skeleton-title"></div>
          <div class="skeleton-price"></div>
          <div class="skeleton-meta"></div>
          <div class="skeleton-description"></div>
          <div class="skeleton-buttons">
            <div class="skeleton-btn"></div>
            <div class="skeleton-btn"></div>
          </div>
        </div>
      </div>
      
      <div class="home-tour-skeleton">
        <div class="skeleton-image"></div>
        <div class="skeleton-content">
          <div class="skeleton-title"></div>
          <div class="skeleton-price"></div>
          <div class="skeleton-meta"></div>
          <div class="skeleton-description"></div>
          <div class="skeleton-buttons">
            <div class="skeleton-btn"></div>
            <div class="skeleton-btn"></div>
          </div>
        </div>
      </div>
      
      <div class="home-tour-skeleton">
        <div class="skeleton-image"></div>
        <div class="skeleton-content">
          <div class="skeleton-title"></div>
          <div class="skeleton-price"></div>
          <div class="skeleton-meta"></div>
          <div class="skeleton-description"></div>
          <div class="skeleton-buttons">
            <div class="skeleton-btn"></div>
            <div class="skeleton-btn"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script define:vars={{ tours, lang }}>
document.addEventListener('DOMContentLoaded', function() {
  const container = document.getElementById('home-tours-grid');
  
  // Delay más corto para la página principal
  setTimeout(() => {
    if (container) {
      // Fade out skeleton
      container.style.opacity = '0';
      container.style.transition = 'opacity 0.3s ease';
      
      setTimeout(() => {
        // Crear HTML de tours reales usando el mismo estilo de las otras páginas
        const toursHTML = tours.map(tour => `
          <div class="tour-card-desktop group relative bg-white/90 backdrop-blur-sm rounded-2xl overflow-hidden shadow-lg hover:shadow-2xl border border-white/60 transition-all duration-500 hover:scale-[1.03] hover:-translate-y-2 cursor-pointer">
            <!-- Badges superiores -->
            <div class="absolute top-3 left-3 z-20 flex flex-col gap-2">
              ${Math.random() > 0.7 ? `
                <div class="bg-red-500 text-white px-3 py-1 rounded-full text-xs font-bold animate-pulse shadow-lg">
                  ${lang === 'en' ? `Only ${Math.floor(Math.random() * 3) + 1} spots!` : `¡Solo ${Math.floor(Math.random() * 3) + 1} cupos!`}
                </div>
              ` : ''}
              
              ${Math.random() > 0.8 ? `
                <div class="bg-gradient-to-r from-purple-500 to-pink-500 text-white px-3 py-1 rounded-full text-xs font-bold shadow-lg">
                  🔥 Popular
                </div>
              ` : ''}
            </div>

            <!-- Botón de favorito -->
            <button class="absolute top-3 right-3 z-20 bg-white/80 hover:bg-white text-gray-600 hover:text-red-500 p-2 rounded-full opacity-0 group-hover:opacity-100 transition-all duration-300 shadow-lg">
              <span class="text-sm">♥</span>
            </button>

            <!-- Imagen -->
            <div class="relative overflow-hidden h-48">
              <img 
                src="${tour.image}" 
                alt="${tour.name}" 
                class="w-full h-full object-cover transition-all duration-700"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-all duration-500"></div>
            </div>
            
            <!-- Contenido -->
            <div class="p-5">
              <!-- Header con rating -->
              <div class="flex justify-between items-start mb-3">
                <a href="${lang === 'en' ? `/tours/${tour.slug}` : `/es/tours/${tour.slug}`}" class="block flex-1 mr-2">
                  <h3 class="text-lg font-bold text-stone-900 group-hover:text-[#b64926] transition-colors leading-tight">
                    ${tour.name}
                  </h3>
                </a>
                
                <div class="flex items-center gap-1 text-yellow-400 text-sm shrink-0">
                  <div class="flex">★★★★★</div>
                  <span class="text-gray-500 text-xs font-medium">(4.8)</span>
                </div>
              </div>

              <!-- Precio -->
              <div class="mb-4 p-3 bg-gradient-to-r from-[#d2a530]/10 to-[#d2a530]/5 rounded-lg border border-[#d2a530]/20">
                <div class="flex items-baseline gap-2 mb-1">
                  <span class="text-2xl font-black text-[#d2a530]">$${tour.price}</span>
                  <span class="text-sm text-gray-600 font-medium">USD</span>
                </div>
                <div class="flex items-center justify-between text-xs">
                  <span class="text-gray-600">${lang === 'en' ? 'per person' : 'por persona'}</span>
                </div>
              </div>

              <!-- Duración -->
              <div class="flex items-center justify-between mb-3 text-sm">
                <div class="flex items-center gap-2 text-gray-600">
                  <span class="text-[#b64926]">⏰</span>
                  <span class="font-semibold">${tour.duration}</span>
                </div>
                
                <div class="flex items-center gap-1 text-green-600 text-xs font-medium">
                  <span>✓</span>
                  ${lang === 'en' ? 'Free cancellation' : 'Cancelación gratis'}
                </div>
              </div>

              <!-- Descripción -->
              <p class="text-sm text-gray-700 mb-4 leading-relaxed line-clamp-2">
                ${tour.description}
              </p>

              <!-- Tags de características -->
              <div class="flex flex-wrap gap-1 mb-4">
                <span class="text-xs bg-blue-50 text-blue-700 px-2 py-1 rounded-full border border-blue-200">
                  👨‍🏫 ${lang === 'en' ? 'Expert guide' : 'Guía especializado'}
                </span>
                <span class="text-xs bg-green-50 text-green-700 px-2 py-1 rounded-full border border-green-200">
                  🚌 ${lang === 'en' ? 'Transport included' : 'Transporte incluido'}
                </span>
              </div>

              <!-- Botones de acción -->
              <div class="space-y-2">
                <a 
                  href="${lang === 'en' ? `/tours/${tour.slug}` : `/es/tours/${tour.slug}`}" 
                  class="block w-full bg-gradient-to-r from-[#b64926] to-[#d2a530] hover:from-[#d2a530] hover:to-[#b64926] text-white font-bold py-3 px-4 rounded-xl text-center transition-all duration-300 transform hover:scale-[1.02] shadow-lg hover:shadow-xl"
                >
                  📋 ${lang === 'en' ? 'View Full Details' : 'Ver detalles completos'}
                </a>
                
                <a 
                  href="https://wa.me/51984302905?text=${lang === 'en' ? `Hello, I would like to book the tour: ${tour.name}` : `Hola, me gustaría reservar el tour: ${tour.name}`}" 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="flex items-center justify-center gap-2 w-full bg-gradient-to-r from-green-500 to-green-600 hover:from-green-600 hover:to-green-700 text-white font-bold py-3 px-4 rounded-xl transition-all duration-300 transform hover:scale-[1.02] shadow-lg hover:shadow-xl"
                >
                  <span>📱</span>
                  <span>${lang === 'en' ? 'Book on WhatsApp' : 'Reservar por WhatsApp'}</span>
                </a>
              </div>
            </div>
          </div>
        `).join('');
        
        container.innerHTML = toursHTML;
        container.style.opacity = '1';
      }, 300);
    }
  }, 1200); // Delay más corto para página principal
});
</script>

<style>
/* Skeleton Styles para Homepage */
.home-tour-skeleton {
  background: white;
  border-radius: 16px;
  overflow: hidden;
  box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
  border: 1px solid rgba(255, 255, 255, 0.6);
}

.skeleton-image {
  height: 192px; /* h-48 equivalent */
  background: linear-gradient(90deg, #f3f4f6 25%, #e5e7eb 50%, #f3f4f6 75%);
  background-size: 200% 100%;
  animation: shimmer 2s infinite;
}

.skeleton-content {
  padding: 20px;
}

.skeleton-title {
  height: 20px;
  background: #e5e7eb;
  border-radius: 4px;
  margin-bottom: 16px;
  width: 80%;
  animation: pulse 2s ease-in-out infinite;
}

.skeleton-price {
  height: 70px;
  background: linear-gradient(135deg, #fef3c7, #fde68a);
  border-radius: 8px;
  margin-bottom: 16px;
  animation: pulse 2s ease-in-out infinite;
}

.skeleton-meta {
  height: 16px;
  background: #e5e7eb;
  border-radius: 4px;
  margin-bottom: 16px;
  width: 60%;
  animation: pulse 2s ease-in-out infinite;
}

.skeleton-description {
  height: 48px;
  background: #e5e7eb;
  border-radius: 4px;
  margin-bottom: 16px;
  animation: pulse 2s ease-in-out infinite;
}

.skeleton-buttons {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.skeleton-btn {
  height: 48px;
  background: #e5e7eb;
  border-radius: 12px;
  animation: pulse 2s ease-in-out infinite;
}

.skeleton-btn:first-child {
  background: linear-gradient(90deg, #fed7aa, #fdba74);
}

.skeleton-btn:last-child {
  background: linear-gradient(90deg, #bbf7d0, #86efac);
}

@keyframes pulse {
  0%, 100% {
    opacity: 1;
  }
  50% {
    opacity: 0.7;
  }
}

@keyframes shimmer {
  0% {
    background-position: 200% 0;
  }
  100% {
    background-position: -200% 0;
  }
}

/* Real Content Styles */
.line-clamp-2 {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.tour-card-desktop:hover {
  box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
}

#home-tours-grid {
  transition: opacity 0.3s ease;
}

/* Responsive adjustments */
@media (max-width: 768px) {
  .home-tour-skeleton {
    margin-bottom: 1rem;
  }
}
</style>
