---
import TourCard from './TourCard.astro';
const { tours, t, lang = 'es' } = Astro.props;
---
<section id="tours" class="py-16 px-4 bg-gray-50">
  <div class="container mx-auto">
    <h2 class="text-4xl font-bold text-center mb-10" style="color: black !important;">{t('tours.title')}</h2>

    <!-- Tours Grid -->
    <div
      id="home-tours-grid"
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6"
    >
      {tours && tours.map(tour => (
        <TourCard tour={tour} lang={lang} t={t} />
      ))}
    </div>
  </div>
</section>

<style>
/* Line clamp para texto */
.line-clamp-2 {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
</style>
