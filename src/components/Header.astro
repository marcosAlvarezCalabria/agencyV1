        <div class="flex justify-center space-x-4">
          <a href="https://www.facebook.com/share/19qWaZ6KHs/?mibextid=qi2Omg" target="_blank" class="text-blue-600 hover:text-blue-800">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M22.675 0h-21.35C.595 0 0 .592 0 1.326v21.348C0 23.408.595 24 1.325 24h11.495v-9.294H9.692v-3.622h3.128V8.413c0-3.1 1.893-4.788 4.659-4.788 1.325 0 2.463.099 2.797.143v3.24l-1.918.001c-1.504 0-1.797.715-1.797 1.763v2.313h3.587l-.467 3.622h-3.12V24h6.116C23.406 24 24 23.408 24 22.674V1.326C24 .592 23.406 0 22.675 0"/>
            </svg>
          </a>
          <a href="https://www.instagram.com/peruinkastravel?utm_source=qr&igsh=MXE1cnN2a3lnejRhbA==" target="_blank" class="text-pink-600 hover:text-pink-800">
