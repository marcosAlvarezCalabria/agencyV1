---
// src/components/Header.astro
const { lang = 'es', t } = Astro.props;
const oppositeLang = lang === 'es' ? 'en' : 'es';

let switchTo;
const path = Astro.url.pathname;
const cleanPath = path
  .replace(/^\/en\//, '/')
  .replace(/^\/es\//, '/')
  .replace(/^\/en/, '')
  .replace(/^\/es/, '');

// Lógica mejorada para tours dinámicos
const isTourDetailEs = /^\/es\/tours\/([^\/]+)$/.test(path);
const isTourDetailEn = /^\/tours\/([^\/]+)$/.test(path);

if (isTourDetailEs || isTourDetailEn) {
  const slug = path.split('/').pop();
  let existsInOtherLang = false;
  if (lang === 'es') {
    try {
      const toursEn = await import('../data/tours.en.json');
      existsInOtherLang = toursEn.default.some(t => t.slug === slug);
    } catch {}
    switchTo = existsInOtherLang ? `/en/tours/${slug}` : '/en/tours';
  } else {
    try {
      const toursEs = await import('../data/tours.es.json');
      existsInOtherLang = toursEs.default.some(t => t.slug === slug);
    } catch {}
    switchTo = existsInOtherLang ? `/es/tours/${slug}` : '/es/tours';
  }
} else {
  if (oppositeLang === 'en') {
    switchTo = `/en${cleanPath === '/' ? '' : cleanPath}`;
  } else {
    switchTo = `/es${cleanPath === '/' ? '' : cleanPath}`;
  }
}

// Generador de enlaces de sección mejorado
function sectionLink(section) {
  if (section === 'tours') {
    return lang === 'es' ? '/es/tours' : '/tours';
  }
  return lang === 'es' ? `/es/#${section}` : `/#${section}`;
}
---

<header id="main-header" data-lang={lang} class="fixed top-0 left-0 w-full z-50 flex items-center h-16 px-6 sm:px-8 bg-transparent border-none shadow-none backdrop-blur-md transition-all duration-300">
  <!-- Logo mejorado -->
  <div class="flex items-center justify-start min-w-0">
    <a href={lang === 'es' ? '/es/' : '/'} class="flex items-center z-10 group">
      <img 
        src="/assets/images/logoInkasTravel.png" 
        alt="Peru Inkas Travel Logo" 
        class="w-14 md:w-20 h-auto transition-all duration-300 ease-in-out drop-shadow-xl group-hover:scale-105 group-hover:drop-shadow-2xl focus:scale-105" 
      />
      <!-- Texto del logo en desktop -->
      <div class="hidden lg:block ml-3 text-white">
        <div class="text-lg font-bold tracking-tight">Peru Inkas</div>
        <div class="text-sm opacity-90 -mt-1">Travel</div>
      </div>
    </a>
  </div>

  <!-- Menú desktop mejorado -->
  <div class="hidden md:flex flex-1 min-w-0 items-center justify-end gap-x-6">
    <nav 
      id="menu-container" 
      class="flex items-center gap-x-6 px-2 sm:px-4 py-2 transition-all duration-300 ease-in-out bg-transparent border-none shadow-none"
    >
      <a href={sectionLink('inicio')} class="menu-link text-lg sm:text-xl font-extrabold px-3 py-2 transition-all duration-300 drop-shadow-md relative">
        <span>{t('nav.home')}</span>
      </a>
      <a href={sectionLink('nosotros')} class="menu-link text-lg sm:text-xl font-extrabold px-3 py-2 transition-all duration-300 drop-shadow-md relative">
        <span>{t('nav.about')}</span>
      </a>
      <a href={sectionLink('tours')} class="menu-link text-lg sm:text-xl font-extrabold px-3 py-2 transition-all duration-300 drop-shadow-md relative">
        <span>{t('nav.tours')}</span>
      </a>
      <a href={sectionLink('destacados')} class="menu-link text-lg sm:text-xl font-extrabold px-3 py-2 transition-all duration-300 drop-shadow-md relative">
        <span>{t('nav.featured')}</span>
      </a>
    </nav>

    <!-- Selector de idioma mejorado (escritorio) -->
    <div class="flex items-center">
      <a href={switchTo} 
         id="lang-toggle-desktop" 
         class="flex items-center gap-x-2 px-4 py-2 text-sm font-bold transition-all duration-300 glassmorphism-lang bg-gradient-to-r from-[#ffe082]/90 to-[#fffde7]/90 text-[#372212] shadow-lg hover:from-[#fffde7] hover:to-[#ffe082] hover:scale-105 focus:scale-105 border border-[#ffe082]/60 rounded-full backdrop-blur-sm" 
         aria-label={`Cambiar a ${oppositeLang === 'es' ? 'Español' : 'English'}`}>
        <span class="material-symbols-outlined !text-lg">language</span>
        <span class="uppercase font-black">{oppositeLang}</span>
      </a>
    </div>
  </div>

  <!-- Menú móvil mejorado -->
  <div class="md:hidden flex flex-1 min-w-0 items-center justify-end gap-x-4">
    <!-- Selector de idioma móvil -->
    <a href={switchTo} 
       id="lang-toggle-mobile" 
       class="flex items-center gap-x-1 px-3 py-1.5 text-xs font-bold transition-all duration-300 glassmorphism-lang bg-gradient-to-r from-[#ffe082]/90 to-[#fffde7]/90 text-[#372212] shadow-md hover:from-[#fffde7] hover:to-[#ffe082] hover:scale-105 focus:scale-105 border border-[#ffe082]/60 rounded-full" 
       aria-label={`Cambiar a ${oppositeLang === 'es' ? 'Español' : 'English'}`}>
      <span class="material-symbols-outlined !text-sm">language</span>
      <span class="uppercase">{oppositeLang}</span>
    </a>

    <!-- Botón hamburguesa mejorado -->
    <button id="menu-btn" 
            class="relative text-[#372212] focus:outline-none hover:scale-110 transition-transform duration-200 p-2 rounded-full bg-white/20 backdrop-blur-sm" 
            aria-label="Abrir menú">
      <div class="hamburger-lines">
        <span class="line line1"></span>
        <span class="line line2"></span>
        <span class="line line3"></span>
      </div>
    </button>
  </div>
</header>

