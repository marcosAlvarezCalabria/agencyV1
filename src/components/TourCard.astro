---
const { tour, t, lang = 'es' } = Astro.props;
if (!tour) {
  return null;
}
const {
  name,
  duration,
  description,
  includes,
  image,
  price,
  slug,
  type,
  difficulty,
  places_to_visit,
  discounts,
  price_options,
  has_photos
} = tour;
const whatsappLink = `https://wa.me/51984302905?text=Hola, me gustaría reservar el tour: ${name}`;
const cardId = `desktop-card-${name.replace(/\s+/g, '').toLowerCase()}`;
const detailsUrl = lang === 'es' ? `/es/tours/${slug}` : `/tours/${slug}`;

// Marketing data - Simular disponibilidad y métricas sociales
const availability = Math.random() > 0.3 ? 'available' : 'limited';
const spotsLeft = availability === 'limited' ? Math.floor(Math.random() * 5) + 2 : null;
const isPopular = Math.random() > 0.65; // 35% de tours son populares
const hasDiscount = discounts && discounts.length > 0;
const discountPercentage = hasDiscount ? discounts[0].percentage : null;
const originalPrice = hasDiscount && price ? Math.floor(price * 1.15) : null;

// Social proof metrics
const rating = 4.8;
const totalReviews = Math.floor(Math.random() * 200) + 50;
const recentBookings = Math.floor(Math.random() * 15) + 5;
---

<div id={cardId}
  class="tour-card-modern group relative bg-white rounded-2xl overflow-hidden shadow-md hover:shadow-2xl border border-gray-100 transition-all duration-500 hover:-translate-y-1 cursor-pointer w-full max-w-sm mx-auto flex flex-col h-full"
  data-name={name}
  data-duration={duration}
  data-description={description}
  data-includes={includes.join('||')}
  data-image={image}
  data-whatsapp={whatsappLink}
  data-slug={slug}
  data-details-url={detailsUrl}
>

  <!-- Imagen principal -->
  <div class="relative overflow-hidden h-56">
    <!-- Skeleton loader -->
    <div class="image-skeleton absolute inset-0 z-0"></div>

    <img
      src={image}
      alt={name}
      class="tour-image w-full h-full object-cover transition-all duration-500 group-hover:scale-110 absolute inset-0 z-10"
      loading="lazy"
    />
    <!-- Overlay sutil -->
    <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/20 to-transparent z-20"></div>

    <!-- Social proof sobre la imagen -->
    <div class="absolute bottom-3 left-3 right-3 flex items-center justify-between z-10">
      <div class="flex items-center gap-1 bg-white/95 backdrop-blur-sm px-2.5 py-1 rounded-full shadow-lg">
        <svg class="w-4 h-4 text-[#d2a530] fill-current" viewBox="0 0 20 20">
          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
        </svg>
        <span class="text-sm font-bold text-gray-900">{rating}</span>
        <span class="text-xs text-gray-600">({totalReviews})</span>
      </div>
    </div>
  </div>

  <!-- Contenido de la card -->
  <div class="p-5 flex flex-col flex-1">
    <!-- Título del tour -->
    <div class="block mb-2">
      <h3 class="text-lg font-bold text-gray-900 group-hover:text-[#b64926] transition-colors leading-snug line-clamp-2">
        {name}
      </h3>
    </div>

    <!-- Trust signals -->
    <div class="flex items-center gap-3 mb-4 text-xs text-gray-600">
      <div class="flex items-center gap-1">
        <svg class="w-3.5 h-3.5 text-[#d2a530]" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
        </svg>
        <span class="font-medium">Cancelación gratis</span>
      </div>
      <div class="flex items-center gap-1">
        <svg class="w-3.5 h-3.5 text-[#b64926]" fill="currentColor" viewBox="0 0 20 20">
          <path d="M9 6a3 3 0 11-6 0 3 3 0 016 0zM17 6a3 3 0 11-6 0 3 3 0 016 0zM12.93 17c.046-.327.07-.66.07-1a6.97 6.97 0 00-1.5-4.33A5 5 0 0119 16v1h-6.07zM6 11a5 5 0 015 5v1H1v-1a5 5 0 015-5z"/>
        </svg>
        <span class="font-medium">{recentBookings} reservas hoy</span>
      </div>
    </div>

    <!-- Precio optimizado para conversión -->
    {price && (
      <div class="mb-4">
        <div class="flex items-baseline gap-2 mb-1">
          <span class="text-3xl font-black text-[#b64926]">${price}</span>
          <span class="text-sm text-gray-500">USD</span>
        </div>
        <div class="text-xs text-gray-600">
          por persona • <span class="font-medium">Mejor precio garantizado</span>
        </div>
      </div>
    )}

    <!-- Información clave del tour -->
    <div class="mb-4 pb-4 border-b border-gray-100">
      <div class="flex items-center gap-4 mb-3">
        <div class="flex items-center gap-1.5 text-gray-700">
          <svg class="w-4 h-4 text-[#b64926]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <span class="text-sm font-semibold">{duration}</span>
        </div>
        {difficulty && (
          <span class="text-xs px-2.5 py-1 rounded-full font-semibold bg-gray-100 text-gray-700">
            {difficulty}
          </span>
        )}
      </div>

      <!-- Descripción -->
      <p class="text-sm text-gray-600 leading-relaxed line-clamp-2">
        {description}
      </p>
    </div>

    <!-- Lugares destacados -->
    {places_to_visit && places_to_visit.length > 0 && (
      <div class="mb-4 p-3 bg-gray-50 rounded-lg border border-gray-200">
        <div class="flex items-center gap-1.5 mb-2">
          <svg class="w-4 h-4 text-[#b64926]" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"/>
          </svg>
          <span class="text-xs font-bold text-gray-900">Visitarás {places_to_visit.length} lugares</span>
        </div>
        <div class="flex flex-wrap gap-1.5">
          {places_to_visit.slice(0, 2).map(place => (
            <span class="text-xs bg-white text-gray-800 px-2 py-0.5 rounded font-medium">
              {place}
            </span>
          ))}
          {places_to_visit.length > 2 && (
            <span class="text-xs text-gray-700 font-medium">
              +{places_to_visit.length - 2} más
            </span>
          )}
        </div>
      </div>
    )}

    <!-- CTAs optimizados -->
    <div class="space-y-2.5 mt-auto" onclick="event.stopPropagation()">
      <!-- CTA primario: Reservar por WhatsApp -->
      <a
        href={whatsappLink}
        target="_blank"
        rel="noopener noreferrer"
        onclick="event.stopPropagation()"
        class="flex items-center justify-center gap-2 w-full bg-[#b64926] hover:bg-[#a03e1f] text-white font-bold py-3.5 px-4 rounded-xl transition-all duration-300 transform hover:scale-[1.02] shadow-lg hover:shadow-xl group relative z-10"
      >
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347"/>
        </svg>
        <span>Reservar ahora</span>
        <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
      </a>
    </div>
  </div>
</div>

<style>
/* Card base */
.tour-card-modern {
  cursor: pointer;
  will-change: transform;
}

/* Line clamp para texto */
.line-clamp-2 {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* Skeleton loader shimmer animation */
@keyframes shimmer {
  0% {
    transform: translateX(-100%);
  }
  100% {
    transform: translateX(100%);
  }
}

.image-skeleton {
  background: #d1d5db;
  overflow: hidden;
}

.image-skeleton::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.4), transparent);
  animation: shimmer 1.5s infinite;
}

.tour-image {
  opacity: 0;
  transition: opacity 0.4s ease-in-out;
}

.tour-image.loaded {
  opacity: 1;
}

/* Responsive */
@media (max-width: 768px) {
  .tour-card-modern:hover {
    transform: translateY(-2px) !important;
  }
}

@media (prefers-reduced-motion: reduce) {
  * {
    animation: none !important;
    transition: none !important;
  }
}
</style>

<script>
  // Manejar la carga de imágenes
  document.addEventListener('DOMContentLoaded', () => {
    const tourImages = document.querySelectorAll('.tour-image');

    tourImages.forEach(img => {
      if (img.complete) {
        // Si la imagen ya está cargada (desde caché)
        img.classList.add('loaded');
        const skeleton = img.previousElementSibling;
        if (skeleton && skeleton.classList.contains('image-skeleton')) {
          skeleton.style.display = 'none';
        }
      } else {
        // Cuando la imagen termine de cargar
        img.addEventListener('load', function() {
          this.classList.add('loaded');
          const skeleton = this.previousElementSibling;
          if (skeleton && skeleton.classList.contains('image-skeleton')) {
            skeleton.style.display = 'none';
          }
        });
      }
    });

    // Manejar clicks en las cards (detectar swipe vs click)
    const tourCards = document.querySelectorAll('.tour-card-modern');

    tourCards.forEach(card => {
      let touchStartX = 0;
      let touchStartY = 0;
      let touchStartTime = 0;

      card.addEventListener('touchstart', (e) => {
        touchStartX = e.touches[0].clientX;
        touchStartY = e.touches[0].clientY;
        touchStartTime = Date.now();
      }, { passive: true });

      card.addEventListener('touchend', (e) => {
        const touchEndX = e.changedTouches[0].clientX;
        const touchEndY = e.changedTouches[0].clientY;
        const touchEndTime = Date.now();

        const deltaX = Math.abs(touchEndX - touchStartX);
        const deltaY = Math.abs(touchEndY - touchStartY);
        const deltaTime = touchEndTime - touchStartTime;

        // Si el movimiento fue mínimo y rápido, es un tap/click
        if (deltaX < 10 && deltaY < 10 && deltaTime < 300) {
          // No hacer nada si se clickeó en el botón de WhatsApp
          const target = e.target as HTMLElement;
          if (!target.closest('a[href*="wa.me"]')) {
            const detailsUrl = card.getAttribute('data-details-url');
            if (detailsUrl) {
              window.location.href = detailsUrl;
            }
          }
        }
      });

      // Para desktop (mouse)
      card.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        // No hacer nada si se clickeó en el botón de WhatsApp
        if (!target.closest('a[href*="wa.me"]')) {
          const detailsUrl = card.getAttribute('data-details-url');
          if (detailsUrl) {
            window.location.href = detailsUrl;
          }
        }
      });
    });
  });
</script>