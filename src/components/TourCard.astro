---
import type { CollectionEntry } from 'astro:content';

// 1. Tipado de Props: Definir interfaces para las props mejora la seguridad y el autocompletado.
interface Props {
  tour: CollectionEntry<'tours'>['data']; // Asumiendo que usas Content Collections
  t: (key: string, params?: Record<string, string | number>) => string;
  lang?: 'es' | 'en';
}

const { tour, t, lang = 'es' } = Astro.props as Props;

if (!tour) {
  return null;
}

const { name, duration, description, includes, image, price, slug } = tour;

// SUGERENCIA: Mover el número de WhatsApp a variables de entorno (.env) para no tenerlo hardcodeado.
const whatsappLink = `https://wa.me/51984302905?text=Hola, me gustaría reservar el tour: ${name}`;
const cardId = `desktop-card-${name.replace(/\s+/g, '').toLowerCase()}`;
const detailsUrl = lang === 'es' ? `/es/tours/${slug}` : `/tours/${slug}`;

// Simular disponibilidad (en producción esto vendría del backend)
const availability = Math.random() > 0.3 ? 'available' : 'limited';
const spotsLeft = availability === 'limited' ? Math.floor(Math.random() * 5) + 1 : null;
const isPopular = Math.random() > 0.7; // 30% de tours son populares

// 2. Consistencia en los Datos: La lógica de descuento ahora es consistente.
const DISCOUNT_PERCENTAGE = 0.15; // 15% de descuento
const hasDiscount = Math.random() > 0.8; // 20% de los tours tienen descuento
const originalPrice = hasDiscount ? Math.round(price / (1 - DISCOUNT_PERCENTAGE)) : null;
const savedAmount = originalPrice ? originalPrice - price : 0;
---

<div id={cardId}
  class="tour-card-desktop group relative flex flex-col bg-white/90 backdrop-blur-sm rounded-2xl overflow-hidden shadow-lg border border-white/60 transition-all duration-500"
  data-name={name}
  data-duration={duration}
  data-description={description}
  data-includes={includes.join('||')}
  data-image={image}
  data-whatsapp={whatsappLink}
  data-slug={slug}
>
  <!-- Badges superiores -->
  <div class="absolute top-3 left-3 z-20 flex flex-col gap-2">
    {availability === 'limited' && spotsLeft && (
      <div class="bg-red-500 text-white px-3 py-1 rounded-full text-xs font-bold animate-pulse shadow-lg" title={t('card.availability.limitedTitle')}>
        {t('card.availability.onlySpotsLeft', { count: spotsLeft })}
      </div>
    )}
    
    {isPopular && (
      <div class="bg-gradient-to-r from-purple-500 to-pink-500 text-white px-3 py-1 rounded-full text-xs font-bold shadow-lg">
        🔥 {t('card.badge.popular')}
      </div>
    )}
    
    {hasDiscount && (
      <div class="bg-orange-500 text-white px-3 py-1 rounded-full text-xs font-bold shadow-lg">
        -{DISCOUNT_PERCENTAGE * 100}% {t('card.badge.today')}
      </div>
    )}
  </div>

  <!-- Botón de favorito -->
  <button class="absolute top-3 right-3 z-20 bg-white/80 hover:bg-white text-gray-600 hover:text-red-500 p-2 rounded-full transition-all duration-300 shadow-lg" aria-label={t('card.actions.addToFavorites')}>
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
    </svg>
  </button>

  <!-- Imagen con efectos mejorados -->
  <div class="relative overflow-hidden h-48 md:h-48 sm:h-64 h-64">
    <!-- Skeleton loader -->
    <div class="absolute inset-0 bg-gradient-to-r from-gray-200 via-gray-300 to-gray-200 animate-pulse tour-img-skeleton">
      <div class="absolute inset-0 bg-gradient-to-r from-transparent via-white/50 to-transparent animate-shimmer"></div>
    </div>
    
    <img 
      src={image} 
      alt={name} 
      class="w-full h-full object-cover transition-all duration-700 group-hover:scale-110 group-hover:brightness-110" 
      loading="lazy"
      onload="this.previousElementSibling.style.display='none'"
      onerror="this.previousElementSibling.innerHTML='<div class=\'flex items-center justify-center h-full text-gray-400\'>Error cargando imagen</div>'"
    />
    
    <!-- Overlay con gradiente -->
    <div class="absolute inset-0 bg-gradient-to-t from-black/30 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-all duration-300"></div>
    
    <!-- Quick view button -->
    <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-all duration-300">
      <button class="bg-white/95 text-gray-900 px-6 py-2 rounded-full font-semibold hover:bg-white hover:scale-105 transition-all duration-200 shadow-lg backdrop-blur-sm" aria-label={t('card.actions.quickView')}>
        <span aria-hidden="true">👁️</span> {t('card.actions.quickView')}
      </button>
    </div>
  </div>

  <!-- Contenido mejorado -->
  <div class="p-4 md:p-5 flex flex-col flex-grow">
    <!-- Header con rating -->
    <div class="flex flex-col md:flex-row justify-between items-start mb-3 gap-2">
      <a href={detailsUrl} class="block flex-1 mr-0 md:mr-2">
        <h3 class="text-lg md:text-xl font-bold text-stone-900 group-hover:text-[#b64926] transition-colors leading-tight line-clamp-2">
            {name}
          </h3>
      </a>
      
      <!-- 3. Accesibilidad (A11y): Rating mejorado para lectores de pantalla -->
      <div class="flex items-center gap-1 text-yellow-400 text-sm shrink-0 mt-1 md:mt-0" role="img" aria-label={t('card.rating.label', { rating: 4.8, max: 5 })}>
        <div class="flex" aria-hidden="true">
          {'★★★★★'.slice(0, 5).split('').map((star, i) => <span class={i < 4.8 ? 'text-yellow-400' : 'text-gray-300'}>{star}</span>)}
        </div>
        <span class="text-gray-500 text-xs font-medium">(4.8)</span>
      </div>
    </div>

    <!-- Precio prominente mejorado -->
    {price && (
      <div class="mb-4 p-2 md:p-3 bg-gradient-to-r from-[#d2a530]/10 to-[#d2a530]/5 rounded-lg border border-[#d2a530]/20">
        <div class="flex items-baseline gap-2 mb-1 flex-wrap">
            {hasDiscount && originalPrice && (
              <span class="text-sm text-gray-400 line-through">${originalPrice}</span>
            )}
            <span class="text-xl md:text-2xl font-black text-[#d2a530]">${price}</span>
            <span class="text-sm text-gray-600 font-medium">USD</span>
          </div>
          <div class="flex items-center justify-between text-xs">
            <span class="text-gray-600">{t('card.price.perPerson')}</span>
            {hasDiscount && savedAmount > 0 && (
              <span class="text-green-600 font-bold">{t('card.price.youSave', { amount: savedAmount })}</span>
            )}
          </div>
        </div>
      
    )}

    <!-- Duración e información destacada -->
  <div class="flex flex-col md:flex-row items-start md:items-center justify-between mb-3 text-sm gap-2">
      <div class="flex items-center gap-2 text-gray-600">
        <svg class="w-4 h-4 text-[#b64926]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        <span class="font-semibold">{duration}</span>
      </div>
      
      <div class="flex items-center gap-1 text-green-600 text-xs font-medium">
        <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
        </svg>
        {t('card.features.freeCancellation')}
      </div>
    </div>

    <!-- Descripción mejorada -->
  <p class="text-sm text-gray-700 mb-4 line-clamp-2 leading-relaxed">
      {description}
    </p>

    <!-- Tags de características -->
  <div class="flex flex-wrap gap-1 mb-4">
      <span class="text-xs px-2 py-1 rounded-full border bg-blue-50 text-blue-700 border-blue-200">🧑‍🏫 {t('card.features.guide')}</span>
      <span class="text-xs px-2 py-1 rounded-full border bg-green-50 text-green-700 border-green-200">🚌 {t('card.features.transport')}</span>
      <span class="text-xs px-2 py-1 rounded-full border bg-purple-50 text-purple-700 border-purple-200">🍽️ {t('card.features.meals')}</span>
    </div>

    <!-- Disponibilidad visual -->
  <div class="mb-4">
      <div class="flex items-center justify-between text-xs mb-1">
        <span class="text-gray-600">{t('card.availability.title')}</span>
        <span class={availability === 'limited' ? 'text-red-600 font-bold' : 'text-green-600 font-medium'}>
          {availability === 'limited' ? t('card.availability.onlySpotsLeft', { count: spotsLeft ?? 0 }) : t('card.availability.available')}
        </span>
      </div>
      <div class="w-full bg-gray-200 rounded-full h-2">
        <div class={`h-2 rounded-full transition-all duration-500 ${
          availability === 'limited' 
            ? 'bg-gradient-to-r from-red-400 to-red-600 w-[25%]' 
            : 'bg-gradient-to-r from-green-400 to-green-600 w-3/4'
        }`}></div>
      </div>
    </div>

    <!-- Botones de acción mejorados -->
    <div class="mt-auto pt-2 space-y-2">
      <!-- Ver detalles -->
      <a 
        href={detailsUrl} 
        class="block w-full bg-gradient-to-r from-[#b64926] to-[#d2a530] hover:from-[#d2a530] hover:to-[#b64926] text-white font-bold py-3 px-4 rounded-xl text-center transition-all duration-300 shadow-lg"
        style="font-size:1rem;"
      >
        📋 {t('card.actions.seeDetails')}
      </a>
      
      <!-- 4. HTML Corregido: Se eliminó el bloque duplicado y las etiquetas mal cerradas -->
      <a href={whatsappLink} target="_blank" rel="noopener noreferrer" class="relative flex items-center justify-center w-full bg-green-500 hover:bg-green-600 text-white font-bold py-3 px-4 rounded-xl text-center transition-all duration-300 shadow-lg">
        <span class="relative z-10">💬 {t('card.actions.enquireNow')}</span>
        {availability === 'limited' && (
          <div class="absolute -top-1 -right-1 w-3 h-3 bg-red-500 rounded-full animate-ping"></div>
        )}
      </a>
    </div>
  </div>
</div>

<style>
/* Skeleton loading mejorado */
.tour-img-skeleton {
  position: relative;
  overflow: hidden;
}

@keyframes shimmer {
  0% { transform: translateX(-100%); }
  100% { transform: translateX(100%); }
}

.animate-shimmer {
  animation: shimmer 2s infinite;
}

/* Line clamp para texto */
.line-clamp-2 {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* Hover effects más fluidos */
.tour-card-desktop:hover {
  box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
}

/* 5. CSS Scoped: El selector universal ahora está acotado al componente para evitar efectos secundarios. */
.tour-card-desktop * {
  /* Se podría quitar si las transiciones de Tailwind son suficientes, 
     pero si se mantiene, es mejor que esté acotado. */
  transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
}

.tour-card-desktop img[src]:not([src=""]) + .tour-img-skeleton {
  display: none;
}

</style>