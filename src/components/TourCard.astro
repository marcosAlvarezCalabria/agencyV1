---
const { tour, t, lang = 'es' } = Astro.props;
if (!tour) {
  return null;
}
const { name, duration, description, includes, image, price, slug } = tour;
const whatsappLink = `https://wa.me/51984302905?text=Hola, me gustaría reservar el tour: ${name}`;
const cardId = `desktop-card-${name.replace(/\s+/g, '').toLowerCase()}`;
const detailsUrl = lang === 'es' ? `/es/tours/${slug}` : `/tours/${slug}`;

// Simular disponibilidad (en producción esto vendría del backend)
const availability = Math.random() > 0.3 ? 'available' : 'limited';
const spotsLeft = availability === 'limited' ? Math.floor(Math.random() * 3) + 1 : null;
const isPopular = Math.random() > 0.7; // 30% de tours son populares
const hasDiscount = Math.random() > 0.8; // 20% tienen descuento
const originalPrice = hasDiscount ? Math.floor(price * 1.2) : null;
---

<div id={cardId}
  class="tour-card-desktop group relative bg-white/90 backdrop-blur-sm rounded-2xl overflow-hidden shadow-lg hover:shadow-2xl border border-white/60 transition-all duration-500 hover:scale-[1.03] hover:-translate-y-2 cursor-pointer"
  data-name={name}
  data-duration={duration}
  data-description={description}
  data-includes={includes.join('||')}
  data-image={image}
  data-whatsapp={whatsappLink}
  data-slug={slug}
>
  <!-- Badges superiores -->
  <div class="absolute top-3 left-3 z-20 flex flex-col gap-2">
    {availability === 'limited' && spotsLeft && (
      <div class="bg-red-500 text-white px-3 py-1 rounded-full text-xs font-bold animate-pulse shadow-lg">
        ¡Solo {spotsLeft} cupos!
      </div>
    )}
    
    {isPopular && (
      <div class="bg-gradient-to-r from-purple-500 to-pink-500 text-white px-3 py-1 rounded-full text-xs font-bold shadow-lg">
        🔥 Popular
      </div>
    )}
    
    {hasDiscount && (
      <div class="bg-orange-500 text-white px-3 py-1 rounded-full text-xs font-bold shadow-lg">
        -15% HOY
      </div>
    )}
  </div>

  <!-- Botón de favorito -->
  <button class="absolute top-3 right-3 z-20 bg-white/80 hover:bg-white text-gray-600 hover:text-red-500 p-2 rounded-full opacity-0 group-hover:opacity-100 transition-all duration-300 shadow-lg">
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
    </svg>
  </button>

  <!-- Imagen con efectos mejorados + PARALLAX -->
  <div class="relative overflow-hidden h-48 parallax-container">
    <!-- Skeleton loader mejorado -->
    <div class="absolute inset-0 bg-gradient-to-r from-gray-200 via-gray-300 to-gray-200 animate-pulse tour-img-skeleton">
      <div class="absolute inset-0 bg-gradient-to-r from-transparent via-white/50 to-transparent animate-shimmer"></div>
    </div>
    
    <!-- Imagen con efecto parallax -->
    <div class="image-parallax-wrapper">
      <img 
        src={image} 
        alt={name} 
        class="w-full h-full object-cover transition-all duration-700 parallax-image" 
        loading="lazy"
        onload="this.parentElement.parentElement.querySelector('.tour-img-skeleton').style.display='none'"
        onerror="this.parentElement.parentElement.querySelector('.tour-img-skeleton').innerHTML='<div class=\'flex items-center justify-center h-full text-gray-400\'>Error cargando imagen</div>'"
      />
    </div>
    
    <!-- Overlay con gradiente dinámico -->
    <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-all duration-500 ease-out"></div>
    
    <!-- Partículas flotantes (efecto premium) -->
    <div class="absolute inset-0 opacity-0 group-hover:opacity-60 transition-all duration-1000">
      <div class="particle particle-1"></div>
      <div class="particle particle-2"></div>
      <div class="particle particle-3"></div>
      <div class="particle particle-4"></div>
      <div class="particle particle-5"></div>
    </div>
    
    <!-- Quick view button mejorado -->
    <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-all duration-500 ease-out">
      <button class="quick-view-btn bg-white/95 text-gray-900 px-6 py-3 rounded-full font-semibold hover:bg-white hover:scale-110 transition-all duration-300 shadow-lg backdrop-blur-sm transform translate-y-4 group-hover:translate-y-0">
        <span class="flex items-center gap-2">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
          </svg>
          Vista rápida
        </span>
      </button>
    </div>

    <!-- Indicador de carga de imagen -->
    <div class="absolute bottom-2 right-2 opacity-0 image-loading-indicator">
      <div class="w-6 h-6 border-2 border-white/30 border-t-white rounded-full animate-spin"></div>
    </div>
  </div>

  <!-- Contenido mejorado -->
  <div class="p-5">
    <!-- Header con rating -->
    <div class="flex justify-between items-start mb-3">
      <a href={detailsUrl} class="block flex-1 mr-2">
        <h3 class="text-lg font-bold text-stone-900 group-hover:text-[#b64926] transition-colors leading-tight line-clamp-2">
          {name}
        </h3>
      </a>
      
      <!-- Rating con estrellas -->
      <div class="flex items-center gap-1 text-yellow-400 text-sm shrink-0">
        <div class="flex">
          ★★★★★
        </div>
        <span class="text-gray-500 text-xs font-medium">(4.8)</span>
      </div>
    </div>

    <!-- Precio prominente mejorado -->
    {price && (
      <div class="mb-4 p-3 bg-gradient-to-r from-[#d2a530]/10 to-[#d2a530]/5 rounded-lg border border-[#d2a530]/20">
        <div class="flex items-baseline gap-2 mb-1">
          {hasDiscount && originalPrice && (
            <span class="text-sm text-gray-400 line-through">${originalPrice}</span>
          )}
          <span class="text-2xl font-black text-[#d2a530]">${price}</span>
          <span class="text-sm text-gray-600 font-medium">USD</span>
        </div>
        <div class="flex items-center justify-between text-xs">
          <span class="text-gray-600">por persona</span>
          {hasDiscount && (
            <span class="text-green-600 font-bold">¡Ahorrás ${originalPrice - price}!</span>
          )}
        </div>
      </div>
    )}

    <!-- Duración e información destacada -->
    <div class="flex items-center justify-between mb-3 text-sm">
      <div class="flex items-center gap-2 text-gray-600">
        <svg class="w-4 h-4 text-[#b64926]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        <span class="font-semibold">{duration}</span>
      </div>
      
      <div class="flex items-center gap-1 text-green-600 text-xs font-medium">
        <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
        </svg>
        Cancelación gratis
      </div>
    </div>

    <!-- Descripción mejorada -->
    <p class="text-sm text-gray-700 mb-4 line-clamp-2 leading-relaxed">
      {description}
    </p>

    <!-- Tags de características -->
    <div class="flex flex-wrap gap-1 mb-4">
      <span class="text-xs bg-blue-50 text-blue-700 px-2 py-1 rounded-full border border-blue-200">
        🧑‍🏫 Guía especializado
      </span>
      <span class="text-xs bg-green-50 text-green-700 px-2 py-1 rounded-full border border-green-200">
        🚌 Transporte incluido
      </span>
      <span class="text-xs bg-purple-50 text-purple-700 px-2 py-1 rounded-full border border-purple-200">
        🍽️ Comidas
      </span>
    </div>

    <!-- Disponibilidad visual -->
    <div class="mb-4">
      <div class="flex items-center justify-between text-xs mb-1">
        <span class="text-gray-600">Disponibilidad</span>
        <span class={availability === 'limited' ? 'text-red-600 font-bold' : 'text-green-600 font-medium'}>
          {availability === 'limited' ? `Solo ${spotsLeft} cupos` : 'Disponible'}
        </span>
      </div>
      <div class="w-full bg-gray-200 rounded-full h-2">
        <div class={`h-2 rounded-full transition-all duration-500 ${
          availability === 'limited' 
            ? 'bg-gradient-to-r from-red-400 to-red-600 w-1/4' 
            : 'bg-gradient-to-r from-green-400 to-green-600 w-3/4'
        }`}></div>
      </div>
    </div>

    <!-- Botones de acción mejorados -->
    <div class="space-y-2">
      <!-- Ver detalles -->
      <a 
        href={detailsUrl} 
        class="block w-full bg-gradient-to-r from-[#b64926] to-[#d2a530] hover:from-[#d2a530] hover:to-[#b64926] text-white font-bold py-3 px-4 rounded-xl text-center transition-all duration-300 transform hover:scale-[1.02] shadow-lg hover:shadow-xl"
      >
        📋 Ver detalles completos
      </a>
      
      <!-- WhatsApp con urgencia -->
      <a 
        href={whatsappLink} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="flex items-center justify-center gap-2 w-full bg-gradient-to-r from-green-500 to-green-600 hover:from-green-600 hover:to-green-700 text-white font-bold py-3 px-4 rounded-xl transition-all duration-300 transform hover:scale-[1.02] shadow-lg hover:shadow-xl relative overflow-hidden"
      >
        <!-- Animación de fondo -->
        <div class="absolute inset-0 bg-gradient-to-r from-green-400 to-green-500 opacity-0 hover:opacity-100 transition-opacity duration-300"></div>
        
        <svg class="w-5 h-5 relative z-10" fill="currentColor" viewBox="0 0 24 24">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347"/>
        </svg>
        <span class="relative z-10">💬 Consultar AHORA</span>
        
        {availability === 'limited' && (
          <div class="absolute -top-1 -right-1 w-3 h-3 bg-red-500 rounded-full animate-ping"></div>
        )}
      </a>
    </div>
  </div>
</div>

<style>
.tour-card-desktop {
  cursor: pointer;
}

/* Skeleton loading mejorado */
.tour-img-skeleton {
  position: relative;
  overflow: hidden;
}

@keyframes shimmer {
  0% { transform: translateX(-100%); }
  100% { transform: translateX(100%); }
}

.animate-shimmer {
  animation: shimmer 2s infinite;
}

/* Line clamp para texto */
.line-clamp-2 {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* Hover effects más fluidos */
.tour-card-desktop:hover {
  box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
}

/* Estados de loading */
.tour-card-desktop img[src=""] + .tour-img-skeleton,
.tour-card-desktop img:not([src]) + .tour-img-skeleton {
  display: block;
}

.tour-card-desktop img[src]:not([src=""]) + .tour-img-skeleton {
  display: none;
}

/* Animaciones más suaves */
* {
  transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
}

/* ================================
   PARALLAX Y EFECTOS AVANZADOS
   ================================ */

.parallax-container {
  perspective: 1000px;
  transform-style: preserve-3d;
}

.image-parallax-wrapper {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
  transform: translateZ(0);
}

.parallax-image {
  transform-origin: center center;
  will-change: transform;
  backface-visibility: hidden;
}

/* Efecto parallax en hover */
.group:hover .parallax-image {
  transform: 
    scale(1.15) 
    translateZ(20px) 
    rotateX(2deg) 
    rotateY(-1deg);
  filter: brightness(1.1) contrast(1.05);
}

/* ================================
   PARTÍCULAS FLOTANTES (MEJORADAS)
   ================================ */

.particle {
  position: absolute;
  width: 8px;
  height: 8px;
  background: radial-gradient(circle, rgba(210, 165, 48, 1) 0%, rgba(210, 165, 48, 0.8) 50%, transparent 100%);
  border-radius: 50%;
  pointer-events: none;
  animation: float 4s ease-in-out infinite;
  box-shadow: 
    0 0 10px rgba(210, 165, 48, 0.6),
    0 0 20px rgba(210, 165, 48, 0.3);
  z-index: 10;
}

.particle-1 {
  top: 20%;
  left: 15%;
  animation-delay: 0s;
  animation-duration: 3s;
  width: 6px;
  height: 6px;
}

.particle-2 {
  top: 60%;
  right: 20%;
  animation-delay: 1s;
  animation-duration: 4s;
  width: 10px;
  height: 10px;
}

.particle-3 {
  bottom: 30%;
  left: 70%;
  animation-delay: 2s;
  animation-duration: 3.5s;
  width: 7px;
  height: 7px;
}

/* Partícula extra para más efecto */
.particle-4 {
  top: 40%;
  left: 80%;
  animation-delay: 1.5s;
  animation-duration: 3.2s;
  width: 5px;
  height: 5px;
}

.particle-5 {
  top: 80%;
  left: 30%;
  animation-delay: 0.5s;
  animation-duration: 4.5s;
  width: 8px;
  height: 8px;
}

@keyframes float {
  0%, 100% {
    transform: translateY(0px) translateX(0px) scale(1);
    opacity: 0.6;
  }
  25% {
    transform: translateY(-20px) translateX(10px) scale(1.3);
    opacity: 1;
  }
  50% {
    transform: translateY(-15px) translateX(-8px) scale(0.8);
    opacity: 0.8;
  }
  75% {
    transform: translateY(-25px) translateX(15px) scale(1.1);
    opacity: 0.9;
  }
}

/* ================================
   BOTÓN MEJORADO
   ================================ */

.quick-view-btn {
  backdrop-filter: blur(8px);
  border: 1px solid rgba(255, 255, 255, 0.2);
  box-shadow: 
    0 8px 25px rgba(0, 0, 0, 0.15),
    inset 0 1px 0 rgba(255, 255, 255, 0.5);
}

.quick-view-btn:hover {
  box-shadow: 
    0 12px 35px rgba(0, 0, 0, 0.2),
    inset 0 1px 0 rgba(255, 255, 255, 0.6);
  background: rgba(255, 255, 255, 0.98);
}

/* ================================
   LOADING STATES
   ================================ */

.image-loading-indicator {
  transition: opacity 0.3s ease;
}

.parallax-image[src=""] ~ .image-loading-indicator,
.parallax-image:not([src]) ~ .image-loading-indicator {
  opacity: 1;
}

/* ================================
   PERFORMANCE OPTIMIZATIONS
   ================================ */

.tour-card-desktop {
  contain: layout style paint;
  transform: translateZ(0);
}

/* ================================
   RESPONSIVE ADJUSTMENTS
   ================================ */

@media (max-width: 768px) {
  /* Disable complex parallax on mobile for performance */
  .group:hover .parallax-image {
    transform: scale(1.08) translateZ(0);
  }
  
  .particle {
    display: none;
  }
  
  .tour-card-desktop {
    transform: none !important;
  }
  
  .tour-card-desktop:hover {
    transform: translateY(-2px) !important;
  }
}

@media (prefers-reduced-motion: reduce) {
  .parallax-image,
  .particle,
  .quick-view-btn {
    animation: none !important;
    transition: none !important;
  }
  
  .group:hover .parallax-image {
    transform: scale(1.05);
  }
}
</style>