---
const { t, tours } = Astro.props;
import ToursCarousel from '../components/ToursCarousel.astro';
import TourCard from '../components/TourCard.astro';
import AboutCard from '../components/AboutCard.astro';

---

<!-- Hero -->
<section id="inicio" class="relative w-full h-screen flex items-center justify-center overflow-hidden">
  <!-- Pantalla de carga mejorada para el video -->
  <div id="video-preloader" class="enhanced-preloader">
    <div class="loader-container">
      <!-- Logo con mejor animación -->
      <div class="logo-wrapper">
        <img 
          src="/assets/images/logoInkasTravel.png" 
          alt="Peru Inkas Travel" 
          class="logo-loader" 
        />
        <!-- Anillo de progreso -->
        <div class="progress-ring">
          <svg class="progress-circle" width="120" height="120">
            <!-- Círculo de fondo -->
            <circle 
              cx="60" 
              cy="60" 
              r="54" 
              stroke="rgba(210, 165, 48, 0.2)" 
              stroke-width="3" 
              fill="transparent" 
              class="progress-track"
            />
            <!-- Círculo de progreso -->
            <circle 
              cx="60" 
              cy="60" 
              r="54" 
              stroke="#d2a530" 
              stroke-width="3" 
              fill="transparent" 
              class="progress-bar"
              stroke-linecap="round"
            />
          </svg>
        </div>
      </div>
      
      <!-- Textos dinámicos -->
      <div class="loading-content">
        <h2 class="loading-title">Peru Inkas Travel</h2>
        <p class="loading-text" id="loading-message">Preparando tu experiencia...</p>
        <div class="loading-dots">
          <span></span>
          <span></span>
          <span></span>
        </div>
      </div>
    </div>
  </div>

  <!-- Video de fondo fijo -->
  <video
    id="hero-video"
    class="fixed inset-0 w-full h-screen object-cover z-0"
    src="/assets/videos/hero-video-portada-2mb.mp4"
    preload="auto"
    playsinline
    muted
    style="pointer-events: none;"
  ></video>
  <!-- Frase centrada -->
  <div class="relative z-20 flex flex-col items-center justify-center text-center px-4">
    <h1 
      id="hero-title"
      class="text-[#372212] uppercase text-3xl sm:text-5xl font-extrabold leading-relaxed drop-shadow-lg opacity-0 translate-y-4 transition-all duration-[2000ms] ease-out"
    >
      {t('hero.title_line1')} <span class="text-[#a67c00]">{t('hero.title_line2')}</span>
    </h1>
    <p id="hero-subtitle" class="text-xl sm:text-3xl text-stone-700 font-semibold mt-4 opacity-0 translate-y-4 transition-all duration-[2000ms] ease-out delay-[500ms]">
      {t('hero.subtitle')}
    </p>
    <a
      id="hero-button"
      href="https://wa.me/51984302905?text=Hola%2C%20me%20gustar%C3%ADa%20obtener%20ayuda%20para%20planificar%20mi%20viaje."
      target="_blank"
      rel="noopener noreferrer"
      class="glassmorphism text-[#372212] font-bold py-3 px-6 rounded-lg mt-12 inline-block hover:bg-white/20 transition-all duration-300 opacity-0 translate-y-4 ease-out delay-[1000ms]"
      style="transition-duration: 2000ms;"
    >
      {t('hero.unlock_trip_planning')}
    </a>
  </div>
</section>

<div class="h-24"></div>

<!-- Sección Tours -->
<section id="tours" class="relative z-30 glassmorphism py-16 px-4 md:px-8 lg:px-16">
  <div class="container mx-auto">
    <h2 class="text-4xl font-bold text-center mb-12 drop-shadow-lg" style="color: #3d1f14 !important;">{t('tours.title')}</h2>

    <!-- Grid para Desktop con skeleton loading -->
    <div 
      id="home-tours-grid" 
      class="hidden md:grid md:grid-cols-3 lg:grid-cols-4 gap-8 tours-grid" 
      data-aos-container
    >
      <!-- Skeleton Cards iniciales -->
      <div class="home-tour-skeleton" data-aos="fade-up" data-aos-delay="0">
        <div class="skeleton-image"></div>
        <div class="skeleton-content">
          <div class="skeleton-title"></div>
          <div class="skeleton-price"></div>
          <div class="skeleton-meta"></div>
          <div class="skeleton-description"></div>
          <div class="skeleton-buttons">
            <div class="skeleton-btn"></div>
            <div class="skeleton-btn"></div>
          </div>
        </div>
      </div>
      
      <div class="home-tour-skeleton" data-aos="fade-up" data-aos-delay="50">
        <div class="skeleton-image"></div>
        <div class="skeleton-content">
          <div class="skeleton-title"></div>
          <div class="skeleton-price"></div>
          <div class="skeleton-meta"></div>
          <div class="skeleton-description"></div>
          <div class="skeleton-buttons">
            <div class="skeleton-btn"></div>
            <div class="skeleton-btn"></div>
          </div>
        </div>
      </div>
      
      <div class="home-tour-skeleton" data-aos="fade-up" data-aos-delay="100">
        <div class="skeleton-image"></div>
        <div class="skeleton-content">
          <div class="skeleton-title"></div>
          <div class="skeleton-price"></div>
          <div class="skeleton-meta"></div>
          <div class="skeleton-description"></div>
          <div class="skeleton-buttons">
            <div class="skeleton-btn"></div>
            <div class="skeleton-btn"></div>
          </div>
        </div>
      </div>
      
      <div class="home-tour-skeleton" data-aos="fade-up" data-aos-delay="150">
        <div class="skeleton-image"></div>
        <div class="skeleton-content">
          <div class="skeleton-title"></div>
          <div class="skeleton-price"></div>
          <div class="skeleton-meta"></div>
          <div class="skeleton-description"></div>
          <div class="skeleton-buttons">
            <div class="skeleton-btn"></div>
            <div class="skeleton-btn"></div>
          </div>
        </div>
      </div>
    </div>

    <!-- Carousel para Móvil -->
    <div class="md:hidden">
      <ToursCarousel tours={tours} t={t} />
    </div>
  </div>
</section>

<div class="h-24"></div>

<!-- Sección Nosotros -->
<section id="nosotros" class="relative z-30 glassmorphism py-16 px-4 md:px-8 lg:px-16">
  <div class="container mx-auto">
    <AboutCard t={t} />
  </div>
</section>

<div class="h-24"></div>

<!-- Cards -->
<section id="destacados" class="relative z-30 bg-gray-50 py-20">
  <div class="max-w-6xl mx-auto px-4">
    <h2 class="text-2xl sm:text-4xl font-bold text-center mb-12 text-green-800">Nuestros tours destacados</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-8 destacados-grid">
      <!-- Card 1 -->
      <div class="relative rounded-xl shadow-lg overflow-hidden flex flex-col items-center justify-end min-h-[350px] featured-card" data-aos="fade-up" data-aos-delay="0">
        <video class="absolute inset-0 w-full h-full object-cover z-0 card-video" src="/assets/videos/hero-video.mp4" loop muted playsinline></video>
        <div class="absolute inset-0 bg-black/40 z-10"></div>
        <div class="relative z-20 p-6 flex flex-col items-center">
          <img src="/assets/images/logoInkasTravel.jpg" alt="Cusco Mágico" class="w-20 h-20 rounded-full object-cover mb-4 border-2 border-green-800 bg-white/80">
          <h3 class="text-xl font-semibold text-white mb-2">Cusco Mágico</h3>
          <p class="text-gray-100 text-center mb-4">Descubre la ciudad imperial y sus maravillas con guías locales apasionados.</p>
          <button class="bg-green-800 text-white px-4 py-2 rounded-lg hover:bg-green-700 transition">Ver más</button>
        </div>
      </div>
      <!-- Card 2 -->
      <div class="relative rounded-xl shadow-lg overflow-hidden flex flex-col items-center justify-end min-h-[350px] featured-card" data-aos="fade-up" data-aos-delay="100">
        <video class="absolute inset-0 w-full h-full object-cover z-0 card-video" src="/assets/videos/hero-video2.mp4" loop muted playsinline></video>
        <div class="absolute inset-0 bg-black/40 z-10"></div>
        <div class="relative z-20 p-6 flex flex-col items-center">
          <img src="/assets/images/logo1.JPG" alt="Aventura Andina" class="w-20 h-20 rounded-full object-cover mb-4 border-2 border-orange-500 bg-white/80">
          <h3 class="text-xl font-semibold text-white mb-2">Aventura Andina</h3>
          <p class="text-gray-100 text-center mb-4">Trekking, cultura y paisajes únicos en rutas poco exploradas de los Andes.</p>
          <button class="bg-orange-500 text-white px-4 py-2 rounded-lg hover:bg-orange-400 transition">Ver más</button>
        </div>
      </div>
      <!-- Card 3: Montaña de Siete Colores -->
      <div class="relative rounded-xl shadow-lg overflow-hidden flex flex-col items-center justify-end min-h-[350px] featured-card" data-aos="fade-up" data-aos-delay="200">
        <video class="absolute inset-0 w-full h-full object-cover z-0 card-video" src="/assets/videos/video7colores.mp4" loop muted playsinline></video>
        <div class="absolute inset-0 bg-black/40 z-10"></div>
        <div class="relative z-20 p-6 flex flex-col items-center">
          <img src="/assets/images/logo.png" alt="Montaña de Siete Colores" class="w-20 h-20 rounded-full object-cover mb-4 border-2 border-yellow-400 bg-white/80">
          <h3 class="text-xl font-semibold text-yellow-600 mb-2">Montaña de Siete Colores</h3>
          <p class="text-gray-100 text-center mb-4">Vive la experiencia única de la Vinicunca con guías locales expertos.</p>
          <button class="bg-yellow-400 text-white px-4 py-2 rounded-lg hover:bg-yellow-300 transition">Ver más</button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
/* =================================
   PRELOADER MEJORADO - ESTILOS
   ================================= */

.enhanced-preloader {
  position: fixed;
  inset: 0;
  z-index: 30;
  display: flex;
  align-items: center;
  justify-content: center;
  /* Gradiente más elegante */
  background: linear-gradient(135deg, #fef7cd 0%, #f3f1ef 50%, #e8f5e8 100%);
  transition: opacity 0.8s ease-in-out;
}

.loader-container {
  text-align: center;
  animation: fadeInUp 1s ease-out;
}

/* =================================
   LOGO Y ANILLO DE PROGRESO
   ================================= */

.logo-wrapper {
  position: relative;
  display: inline-block;
  margin-bottom: 2rem;
}

.logo-loader {
  width: 80px;
  height: 80px;
  border-radius: 50%;
  object-fit: cover;
  /* Sombra elegante */
  box-shadow: 
    0 8px 25px rgba(210, 165, 48, 0.3),
    0 4px 10px rgba(0, 0, 0, 0.1);
  /* Animación suave */
  animation: logoFloat 3s ease-in-out infinite;
  /* Borde dorado sutil */
  border: 3px solid rgba(210, 165, 48, 0.2);
}

.progress-ring {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 120px;
  height: 120px;
}

.progress-circle {
  transform: rotate(-90deg);
  width: 100%;
  height: 100%;
}

.progress-bar {
  /* Circunferencia del círculo: 2 * PI * radius = 2 * 3.14159 * 54 ≈ 339.292 */
  stroke-dasharray: 339.292;
  stroke-dashoffset: 339.292;
  animation: progressLoad 4s ease-out forwards;
  /* Efecto de brillo */
  filter: drop-shadow(0 0 3px rgba(210, 165, 48, 0.4));
}

/* =================================
   CONTENIDO DE TEXTO
   ================================= */

.loading-content {
  max-width: 300px;
  margin: 0 auto;
}

.loading-title {
  font-size: 1.5rem;
  font-weight: 700;
  color: #372212;
  margin-bottom: 0.5rem;
  letter-spacing: 0.05em;
  animation: titleGlow 2s ease-in-out infinite alternate;
}

.loading-text {
  color: #6b5b47;
  font-weight: 500;
  font-size: 1.1rem;
  margin-bottom: 1rem;
  animation: textFade 2s ease-in-out infinite alternate;
}

/* =================================
   DOTS ANIMADOS
   ================================= */

.loading-dots {
  display: flex;
  justify-content: center;
  gap: 0.5rem;
  margin-top: 1rem;
}

.loading-dots span {
  width: 8px;
  height: 8px;
  background: #d2a530;
  border-radius: 50%;
  animation: dotBounce 1.4s ease-in-out infinite both;
}

/* ===============================
   ANIMACIONES DE ENTRADA (AOS)
   =============================== */

/* Estados iniciales - elementos ocultos */
[data-aos] {
  opacity: 0;
  transform: translateY(30px);
  transition: all 0.8s cubic-bezier(0.4, 0, 0.2, 1);
}

/* Estados cuando aparecen */
[data-aos].aos-animate {
  opacity: 1;
  transform: translateY(0);
}

/* Variaciones de animación */
[data-aos="fade-up"] {
  transform: translateY(50px);
}

[data-aos="fade-up"].aos-animate {
  transform: translateY(0);
}

[data-aos="fade-left"] {
  transform: translateX(-50px);
}

[data-aos="fade-left"].aos-animate {
  transform: translateX(0);
}

[data-aos="fade-right"] {
  transform: translateX(50px);
}

[data-aos="fade-right"].aos-animate {
  transform: translateX(0);
}

/* Contenedores especiales */
.tour-card-container {
  transition-delay: var(--delay, 0ms);
}

.featured-card {
  transition: all 0.8s cubic-bezier(0.4, 0, 0.2, 1);
}

/* Animación de títulos */
.section-title {
  opacity: 0;
  transform: translateY(20px);
  transition: all 0.6s ease-out;
}

.section-title.aos-animate {
  opacity: 1;
  transform: translateY(0);
}

/* Skeleton Styles para Homepage */
.home-tour-skeleton {
  background: white;
  border-radius: 16px;
  overflow: hidden;
  box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
  border: 1px solid rgba(255, 255, 255, 0.6);
}

.skeleton-image {
  height: 192px; /* h-48 equivalent */
  background: linear-gradient(90deg, #f3f4f6 25%, #e5e7eb 50%, #f3f4f6 75%);
  background-size: 200% 100%;
  animation: shimmer 2s infinite;
}

.skeleton-content {
  padding: 20px;
}

.skeleton-title {
  height: 20px;
  background: #e5e7eb;
  border-radius: 4px;
  margin-bottom: 16px;
  width: 80%;
  animation: pulse 2s ease-in-out infinite;
}

.skeleton-price {
  height: 70px;
  background: linear-gradient(135deg, #fef3c7, #fde68a);
  border-radius: 8px;
  margin-bottom: 16px;
  animation: pulse 2s ease-in-out infinite;
}

.skeleton-meta {
  height: 16px;
  background: #e5e7eb;
  border-radius: 4px;
  margin-bottom: 16px;
  width: 60%;
  animation: pulse 2s ease-in-out infinite;
}

.skeleton-description {
  height: 48px;
  background: #e5e7eb;
  border-radius: 4px;
  margin-bottom: 16px;
  animation: pulse 2s ease-in-out infinite;
}

.skeleton-buttons {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.skeleton-btn {
  height: 48px;
  background: #e5e7eb;
  border-radius: 12px;
  animation: pulse 2s ease-in-out infinite;
}

.skeleton-btn:first-child {
  background: linear-gradient(90deg, #fed7aa, #fdba74);
}

.skeleton-btn:last-child {
  background: linear-gradient(90deg, #bbf7d0, #86efac);
}

@keyframes shimmer {
  0% {
    background-position: 200% 0;
  }
  100% {
    background-position: -200% 0;
  }
}

/* Tour Card Styles */
.tour-card-real {
  opacity: 0;
  transform: translateY(30px);
  transition: all 0.8s cubic-bezier(0.4, 0, 0.2, 1);
}

.tour-card-real.aos-animate {
  opacity: 1;
  transform: translateY(0);
}

.line-clamp-2 {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.tour-card-desktop:hover {
  box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
}

#home-tours-grid {
  transition: opacity 0.3s ease;
}

.loading-dots span:nth-child(1) { animation-delay: -0.32s; }
.loading-dots span:nth-child(2) { animation-delay: -0.16s; }
.loading-dots span:nth-child(3) { animation-delay: 0s; }

/* =================================
   ANIMACIONES KEYFRAMES
   ================================= */

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(30px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes logoFloat {
  0%, 100% { 
    transform: translateY(0) scale(1);
  }
  50% { 
    transform: translateY(-5px) scale(1.02);
  }
}

@keyframes progressLoad {
  0% {
    stroke-dashoffset: 339.292;
  }
  100% {
    stroke-dashoffset: 0;
  }
}

@keyframes titleGlow {
  0% {
    text-shadow: 0 0 5px rgba(210, 165, 48, 0.3);
  }
  100% {
    text-shadow: 0 0 15px rgba(210, 165, 48, 0.6);
  }
}

@keyframes textFade {
  0% { opacity: 0.7; }
  100% { opacity: 1; }
}

@keyframes dotBounce {
  0%, 80%, 100% {
    transform: scale(0.8);
    opacity: 0.5;
  }
  40% {
    transform: scale(1.2);
    opacity: 1;
  }
}

/* =================================
   RESPONSIVE
   ================================= */

@media (max-width: 640px) {
  .logo-loader {
    width: 60px;
    height: 60px;
  }
  
  .progress-ring {
    width: 100px;
    height: 100px;
  }
  
  .loading-title {
    font-size: 1.25rem;
  }
  
  .loading-text {
    font-size: 1rem;
  }
}
</style>

<script is:inline>
  // =================================
  // JAVASCRIPT PARA TEXTOS DINÁMICOS
  // =================================
  (() => {
    const loadingMessages = [
      'Preparando tu experiencia...',
      'Cargando vistas increíbles...',
      'Conectando con la magia de Cusco...',
      'Casi listo para el viaje...'
    ];
    
    let messageIndex = 0;
    let messageInterval;
    
    const initPreloaderMessages = () => {
      const messageElement = document.getElementById('loading-message');
      
      if (messageElement) {
        // Cambiar mensaje cada 1.5 segundos
        messageInterval = setInterval(() => {
          messageIndex = (messageIndex + 1) % loadingMessages.length;
          messageElement.textContent = loadingMessages[messageIndex];
        }, 1500);
        
        // Limpiar interval cuando se quite el preloader
        const preloader = document.getElementById('video-preloader');
        if (preloader) {
          const observer = new MutationObserver((mutations) => {
            mutations.forEach((mutation) => {
              if (mutation.type === 'attributes') {
                const hasOpacity0 = preloader.classList.contains('opacity-0');
                const isDisplayNone = preloader.style.display === 'none';
                
                if (hasOpacity0 || isDisplayNone) {
                  clearInterval(messageInterval);
                  observer.disconnect();
                }
              }
            });
          });
          
          observer.observe(preloader, { 
            attributes: true, 
            attributeFilter: ['style', 'class'] 
          });
        }
      }
    };
    
    // Inicializar cuando el DOM esté listo
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initPreloaderMessages);
    } else {
      initPreloaderMessages();
    }
  })();

  // =================================
  // SCRIPT ORIGINAL DEL HERO
  // =================================
  window.addEventListener('DOMContentLoaded', () => {
    const heroTitle = document.getElementById('hero-title');
    const heroSubtitle = document.getElementById('hero-subtitle');
    const heroButton = document.getElementById('hero-button');
    const preloader = document.getElementById('video-preloader');
    const heroVideo = document.getElementById('hero-video');

    // Animación de entrada y preloader
    if (heroVideo && preloader && heroTitle && heroSubtitle && heroButton) {
      let shown = false;
      const showContent = () => {
        if (shown) return;
        shown = true;
        // Acelera el video durante 200ms
        heroVideo.playbackRate = 2.5;
        setTimeout(() => { heroVideo.playbackRate = 1; }, 200);
        heroVideo.play();
        preloader.classList.add('opacity-0');
        setTimeout(() => { preloader.style.display = 'none'; }, 500);
        setTimeout(() => {
          heroTitle.classList.remove('opacity-0', 'translate-y-4');
          heroSubtitle.classList.remove('opacity-0', 'translate-y-4');
          heroButton.classList.remove('opacity-0', 'translate-y-4');
        }, 2000);
      };
      heroVideo.addEventListener('canplay', showContent, { once: true });
      setTimeout(showContent, 4000);
    }

    // Videos en cards: reproducción solo en hover (desktop) o visibilidad (móvil)
    const cardVideos = document.querySelectorAll('.card-video');
    cardVideos.forEach(video => { video.muted = true; }); // Forzar muted por compatibilidad
    const isTouch = 'ontouchstart' in window || navigator.maxTouchPoints > 0;
    if (isTouch && 'IntersectionObserver' in window) {
      // Móvil: reproducir solo si el video está visible (al centro)
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          const video = entry.target;
          if (!video.__userPlayed && entry.isIntersecting) {
            // No reproducir automáticamente, esperar interacción
            video.pause();
          }
          if (!entry.isIntersecting) {
            video.pause();
            video.__userPlayed = false;
          }
        });
      }, { threshold: 0.5 });
      cardVideos.forEach(video => {
        video.pause();
        observer.observe(video);
        // Fallback: reproducir al tocar cualquier parte de la card
        const card = video.closest('.relative');
        if (card) {
          card.addEventListener('touchstart', () => {
            video.__userPlayed = true;
            video.play().catch(() => {});
          });
        } else {
          video.addEventListener('touchstart', () => {
            video.__userPlayed = true;
            video.play().catch(() => {});
          });
        }
      });
    } else {
      // Desktop: reproducir solo en hover sobre la card (no solo el video)
      cardVideos.forEach(video => {
        video.pause();
        const card = video.closest('.relative');
        if (card) {
          card.addEventListener('mouseenter', () => {
            video.play().catch(() => {});
          });
          card.addEventListener('mouseleave', () => {
            video.pause();
          });
        } else {
          // Fallback: listeners en el video
          video.addEventListener('mouseenter', () => {
            video.play().catch(() => {});
          });
          video.addEventListener('mouseleave', () => {
            video.pause();
          });
        }
      });
    }

   /* // Scroll automático al detectar interacción SOLO si estamos cerca del hero
    let scrollTriggered = false;
    const scrollToTours = () => {
      if (scrollTriggered) return;
      // Solo activar si el usuario está cerca del top (hero)
      if (window.scrollY > 200) return;
      scrollTriggered = true;
      const toursSection = document.getElementById('tours');
      if (toursSection) {
        const y = toursSection.getBoundingClientRect().top + window.scrollY - 24;
        window.scrollTo({ top: y, behavior: 'smooth' });
      }
    };
    window.addEventListener('touchstart', scrollToTours, { once: true });
    window.addEventListener('wheel', scrollToTours, { once: true });
    window.addEventListener('keydown', (e) => {
      if ([32, 33, 34, 35, 36, 38, 40].includes(e.keyCode)) scrollToTours();
    }, { once: true });*/

    // ===============================
    // SISTEMA DE ANIMACIONES AOS
    // ===============================
    
    // Configuración del Intersection Observer para animaciones (trigger temprano)
    const observerOptions = {
      threshold: 0.05,  // Se activa cuando solo el 5% es visible
      rootMargin: '0px 0px 150px 0px'  // Se activa 150px ANTES de que el elemento entre en vista
    };
    
    const animationObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const element = entry.target;
          const delay = element.getAttribute('data-aos-delay') || 0;
          
          // Aplicar delay si existe
          setTimeout(() => {
            element.classList.add('aos-animate');
          }, parseInt(delay));
          
          // Dejar de observar este elemento
          animationObserver.unobserve(element);
        }
      });
    }, observerOptions);
    
    // Observar todos los elementos con data-aos
    const elementsToAnimate = document.querySelectorAll('[data-aos]');
    elementsToAnimate.forEach(element => {
      animationObserver.observe(element);
    });
    
    // Animación especial para títulos de sección
    const sectionTitles = document.querySelectorAll('h2');
    sectionTitles.forEach(title => {
      title.classList.add('section-title');
      animationObserver.observe(title);
    });
    
    // Efecto especial: animar cards en secuencia
    const tourCards = document.querySelectorAll('.tour-card-container');
    const featuredCards = document.querySelectorAll('.featured-card');
    
    // Configurar delays dinámicos para tour cards (más rápido)
    tourCards.forEach((card, index) => {
      card.style.setProperty('--delay', `${index * 50}ms`);
    });
    
    // Configurar delays dinámicos para featured cards (más rápido)
    featuredCards.forEach((card, index) => {
      card.style.setProperty('--delay', `${index * 100}ms`);
    });
    
    // ===============================
    // SKELETON LOADING PARA TOURS
    // ===============================
    
    const handleToursSkeletonLoading = () => {
      const container = document.getElementById('home-tours-grid');
      if (!container) return;
      
      // Datos de tours pasados desde Astro
      const toursData = JSON.parse(document.getElementById('tours-data')?.textContent || '[]');
      
      // Observar cuando la sección de tours sea visible
      const toursObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            // Una vez que la sección sea visible, esperar 1.5s y reemplazar skeleton
            setTimeout(() => {
              replaceSkeleton(container, toursData);
            }, 1500);
            
            // Dejar de observar
            toursObserver.unobserve(entry.target);
          }
        });
      }, {
        threshold: 0.1,
        rootMargin: '0px 0px 100px 0px'
      });
      
      // Observar la sección de tours
      const toursSection = document.getElementById('tours');
      if (toursSection) {
        toursObserver.observe(toursSection);
      }
    };
    
    const replaceSkeleton = (container, toursData) => {
      if (!toursData || toursData.length === 0) return;
      
      // Fade out skeleton
      container.style.opacity = '0';
      
      setTimeout(() => {
        // Crear HTML de tours reales
        const toursHTML = toursData.map((tour, index) => `
          <div class="tour-card-real" data-aos="fade-up" data-aos-delay="${index * 50}">
            <div class="tour-card-desktop group relative bg-white/90 backdrop-blur-sm rounded-2xl overflow-hidden shadow-lg hover:shadow-2xl border border-white/60 transition-all duration-500 hover:scale-[1.03] hover:-translate-y-2 cursor-pointer">
              <!-- Badges superiores -->
              <div class="absolute top-3 left-3 z-20 flex flex-col gap-2">
                ${Math.random() > 0.7 ? `
                  <div class="bg-red-500 text-white px-3 py-1 rounded-full text-xs font-bold animate-pulse shadow-lg">
                    ¡Solo ${Math.floor(Math.random() * 3) + 1} cupos!
                  </div>
                ` : ''}
                
                ${Math.random() > 0.8 ? `
                  <div class="bg-gradient-to-r from-purple-500 to-pink-500 text-white px-3 py-1 rounded-full text-xs font-bold shadow-lg">
                    🔥 Popular
                  </div>
                ` : ''}
              </div>

              <!-- Botón de favorito -->
              <button class="absolute top-3 right-3 z-20 bg-white/80 hover:bg-white text-gray-600 hover:text-red-500 p-2 rounded-full opacity-0 group-hover:opacity-100 transition-all duration-300 shadow-lg">
                <span class="text-sm">♥</span>
              </button>

              <!-- Imagen -->
              <div class="relative overflow-hidden h-48">
                <img 
                  src="${tour.image}" 
                  alt="${tour.name}" 
                  class="w-full h-full object-cover transition-all duration-700"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-all duration-500"></div>
              </div>
              
              <!-- Contenido -->
              <div class="p-5">
                <!-- Header con rating -->
                <div class="flex justify-between items-start mb-3">
                  <a href="/es/tours/${tour.slug}" class="block flex-1 mr-2">
                    <h3 class="text-lg font-bold text-stone-900 group-hover:text-[#b64926] transition-colors leading-tight">
                      ${tour.name}
                    </h3>
                  </a>
                  
                  <div class="flex items-center gap-1 text-yellow-400 text-sm shrink-0">
                    <div class="flex">★★★★★</div>
                    <span class="text-gray-500 text-xs font-medium">(4.8)</span>
                  </div>
                </div>

                <!-- Precio -->
                <div class="mb-4 p-3 bg-gradient-to-r from-[#d2a530]/10 to-[#d2a530]/5 rounded-lg border border-[#d2a530]/20">
                  <div class="flex items-baseline gap-2 mb-1">
                    <span class="text-2xl font-black text-[#d2a530]">${tour.price}</span>
                    <span class="text-sm text-gray-600 font-medium">USD</span>
                  </div>
                  <div class="flex items-center justify-between text-xs">
                    <span class="text-gray-600">por persona</span>
                  </div>
                </div>

                <!-- Duración -->
                <div class="flex items-center justify-between mb-3 text-sm">
                  <div class="flex items-center gap-2 text-gray-600">
                    <span class="text-[#b64926]">⏰</span>
                    <span class="font-semibold">${tour.duration}</span>
                  </div>
                  
                  <div class="flex items-center gap-1 text-green-600 text-xs font-medium">
                    <span>✓</span>
                    Cancelación gratis
                  </div>
                </div>

                <!-- Descripción -->
                <p class="text-sm text-gray-700 mb-4 leading-relaxed line-clamp-2">
                  ${tour.description}
                </p>

                <!-- Tags de características -->
                <div class="flex flex-wrap gap-1 mb-4">
                  <span class="text-xs bg-blue-50 text-blue-700 px-2 py-1 rounded-full border border-blue-200">
                    👨‍🏫 Guía especializado
                  </span>
                  <span class="text-xs bg-green-50 text-green-700 px-2 py-1 rounded-full border border-green-200">
                    🚌 Transporte incluido
                  </span>
                </div>

                <!-- Botones de acción -->
                <div class="space-y-2">
                  <a 
                    href="/es/tours/${tour.slug}" 
                    class="block w-full bg-gradient-to-r from-[#b64926] to-[#d2a530] hover:from-[#d2a530] hover:to-[#b64926] text-white font-bold py-3 px-4 rounded-xl text-center transition-all duration-300 transform hover:scale-[1.02] shadow-lg hover:shadow-xl"
                  >
                    📋 Ver detalles completos
                  </a>
                  
                  <a 
                    href="https://wa.me/51984302905?text=Hola, me gustaría reservar el tour: ${tour.name}" 
                    target="_blank" 
                    rel="noopener noreferrer" 
                    class="flex items-center justify-center gap-2 w-full bg-gradient-to-r from-green-500 to-green-600 hover:from-green-600 hover:to-green-700 text-white font-bold py-3 px-4 rounded-xl transition-all duration-300 transform hover:scale-[1.02] shadow-lg hover:shadow-xl"
                  >
                    <span>📱</span>
                    <span>Reservar por WhatsApp</span>
                  </a>
                </div>
              </div>
            </div>
          </div>
        `).join('');
        
        container.innerHTML = toursHTML;
        container.style.opacity = '1';
        
        // Re-observar los nuevos elementos para AOS
        const newElements = container.querySelectorAll('.tour-card-real');
        newElements.forEach(element => {
          animationObserver.observe(element);
        });
        
      }, 300);
    };
    
    // Inicializar skeleton loading
    handleToursSkeletonLoading();
  });
</script>

<!-- Datos JSON para el script -->
<script id="tours-data" type="application/json" set:html={JSON.stringify(tours)}></script>