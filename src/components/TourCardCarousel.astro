---
const { tour, t, lang = 'es' } = Astro.props;
if (!tour) {
  // No renderizar nada si el tour no está definido
  return null;
}
const { name, duration, description, includes, image, images = [], price, slug } = tour;
const cardId = `carousel-card-${name.replace(/\s+/g, '').toLowerCase()}`;
const detailsUrl = lang === 'es' ? `/es/tours/${slug}` : `/tours/${slug}`;

let mainImage = image;
if (images.length > 0) {
  mainImage = images[0];
}

let selectedIndex = 0;

function selectImage(idx) {
  selectedIndex = idx;
  mainImage = images[idx] || image;
  // For Astro Islands, this would need to be a client:load or client:visible component for reactivity
}
---
<div id={cardId}
  class="tour-card-carousel bg-white/70 backdrop-blur-md p-4 flex flex-col h-full text-stone-800 shadow-lg overflow-hidden border border-solid border-white/60 select-none"
  data-name={name}
  data-duration={duration}
  data-description={description}
  data-includes={includes.join('||')}
  data-image={image}
>
  <img src={mainImage} alt={name} class="w-full h-32 object-cover mb-3 transition-all duration-300" loading="lazy" />
  <h3 class="text-xl font-bold text-stone-900 mb-1">{name}</h3>
  {price && (
    <div class="inline-block bg-[#d2a530] text-[#372212] text-base font-semibold px-3 py-1 mb-2 price-badge">
      {(t('card.from') || 'From') + ' ' + price + ' USD'}
    </div>
  )}
  <p class="text-sm text-stone-700 mb-4 flex items-center">
    <span class="material-symbols-outlined mr-2 text-base">schedule</span>
    {duration}
  </p>
  <div class="text-sm text-stone-700 mb-4 flex-grow">
    <p>{description}</p>
  </div>
  <div id={cardId}
    class="tour-card-carousel bg-white/70 backdrop-blur-md p-4 flex flex-col h-full text-stone-800 shadow-lg overflow-hidden border border-solid border-white/60 select-none"
    data-name={name}
    data-duration={duration}
    data-description={description}
    data-includes={includes.join('||')}
    data-image={image}
    ontouchstart="window.__touchStartX = event.touches[0].clientX; window.__touchStartY = event.touches[0].clientY; window.__touchMoved = false;"
    ontouchmove="if(Math.abs(event.touches[0].clientX-window.__touchStartX)>10 || Math.abs(event.touches[0].clientY-window.__touchStartY)>10){window.__touchMoved=true;}"
    ontouchend="if(!window.__touchMoved){window.location.href=''+detailsUrl;}"
    onclick="window.location.href=''+detailsUrl;"
  >
    <a href={`https://wa.me/51984302905?text=Hola, me gustaría reservar el tour: ${name}`}
       target="_blank"
       rel="noopener noreferrer"
       class="mt-2 bg-[#a67c00] text-white font-bold py-2 px-4 text-center w-full block cursor-pointer hover:bg-[#b88a2a] transition-colors whatsapp-btn"
       style="box-shadow:0 2px 8px #a67c0033;"
       ontouchstart="event.stopPropagation();"
       onclick="event.stopPropagation();">
      {t('card.bookNow')}
    </a>
  </div>
</div>
