---
// src/components/FloatingWhatsApp.astro
const { message = "Hola, me gustaría obtener información sobre sus tours en Cusco" } = Astro.props;
const whatsappNumber = "51984302905";
const encodedMessage = encodeURIComponent(message);
const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${encodedMessage}`;
---

<!-- WhatsApp Flotante con mejoras UX -->
<div id="whatsapp-floating" class="fixed bottom-6 right-6 z-50 group">
  <!-- Tooltip promocional -->
  <div id="whatsapp-tooltip" class="absolute bottom-full right-0 mb-4 opacity-0 pointer-events-none transform translate-y-2 transition-all duration-300 group-hover:opacity-100 group-hover:translate-y-0 group-hover:pointer-events-auto">
    <div class="bg-white rounded-2xl shadow-xl p-4 min-w-[280px] border border-gray-100">
      <!-- Header del tooltip -->
      <div class="flex items-center gap-2 mb-2">
        <div class="w-8 h-8 bg-green-500 rounded-full flex items-center justify-center">
          <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 24 24">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347"/>
          </svg>
        </div>
        <div>
          <div class="font-semibold text-gray-900 text-sm">¡Consulta gratuita!</div>
          <div class="text-xs text-green-600">En línea ahora</div>
        </div>
      </div>
      
      <!-- Contenido del tooltip -->
      <div class="text-sm text-gray-700 mb-3">
        <p>✅ Respuesta inmediata</p>
        <p>✅ Planes personalizados</p>
        <p>✅ Precios especiales</p>
      </div>
      
      <!-- Testimonial mini -->
      <div class="bg-gray-50 rounded-lg p-2 text-xs">
        <div class="flex items-center gap-1 mb-1">
          <div class="flex text-yellow-400">★★★★★</div>
          <span class="text-gray-600">María, España</span>
        </div>
        <p class="text-gray-700 italic">"Excelente atención y tours increíbles"</p>
      </div>
      
      <!-- Flecha del tooltip -->
      <div class="absolute top-full right-6 w-0 h-0 border-l-8 border-r-8 border-t-8 border-l-transparent border-r-transparent border-t-white filter drop-shadow-sm"></div>
    </div>
  </div>

  <!-- Badge de notificación -->
  <div class="absolute -top-1 -right-1 w-6 h-6 bg-red-500 rounded-full flex items-center justify-center animate-pulse">
    <span class="text-white text-xs font-bold">1</span>
  </div>

  <!-- Botón principal -->
  <a 
    href={whatsappUrl}
    target="_blank"
    rel="noopener noreferrer"
    id="whatsapp-main-btn"
    class="whatsapp-btn flex items-center gap-3 bg-gradient-to-r from-green-500 to-green-600 hover:from-green-600 hover:to-green-700 text-white px-5 py-4 rounded-2xl shadow-lg hover:shadow-2xl transition-all duration-300 transform hover:scale-105 active:scale-95"
    aria-label="Contactar por WhatsApp"
  >
    <!-- Icono de WhatsApp con animación -->
    <div class="relative">
      <svg class="w-7 h-7 animate-bounce-subtle" fill="currentColor" viewBox="0 0 24 24">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347"/>
      </svg>
    </div>
    
    <!-- Texto (solo desktop) -->
    <div class="hidden md:block">
      <div class="text-sm font-bold">¡Consultá gratis!</div>
      <div class="text-xs opacity-90">Respuesta inmediata</div>
    </div>
  </a>
</div>

<style>
@keyframes bounce-subtle {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-2px); }
}

.animate-bounce-subtle {
  animation: bounce-subtle 2s infinite;
}

.whatsapp-btn {
  position: relative;
  overflow: hidden;
}

.whatsapp-btn::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
  transition: left 0.5s;
}

.whatsapp-btn:hover::before {
  left: 100%;
}
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const floatingBtn = document.getElementById('whatsapp-floating');
    
    // Auto-mostrar tooltip después de un tiempo
    setTimeout(() => {
      if (floatingBtn) {
        floatingBtn.classList.add('animate-pulse');
        setTimeout(() => {
          floatingBtn.classList.remove('animate-pulse');
        }, 3000);
      }
    }, 5000);

    // Tracking de clics
    const whatsappBtn = document.getElementById('whatsapp-main-btn');
    whatsappBtn?.addEventListener('click', () => {
      if (typeof gtag !== 'undefined') {
        gtag('event', 'whatsapp_click', {
          event_category: 'engagement',
          event_label: 'floating_button'
        });
      }
    });
  });
</script>