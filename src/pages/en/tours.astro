---
import BaseLayout from '../../layouts/Baselayout.astro';
import toursEn from '../../data/tours.en.json';
import TourCard from '../../components/TourCard.astro';
import ToursCarousel from '../../components/ToursCarousel.astro';
import { useTranslations } from '../../i18n/utils';

const t = useTranslations('en');
const seo = {
  title: 'Our Tours | Agencia Cusco',
  description: 'Discover our best tours in Cusco and Peru. Adventure, culture and more with Agencia Cusco.',
  hreflangs: [
    { lang: 'en', url: '/en/tours' },
    { lang: 'es', url: '/es/tours' }
  ]
};
---
<BaseLayout lang="en" t={t} seo={seo}>
  <section 
    id="tours" 
    class="relative py-16 px-4 bg-cover bg-center"
    style="background-image: url('/assets/images/tours-bg.jpg');"
  >
    <div class="absolute inset-0 bg-black/40"></div>
    <div class="relative container mx-auto">
      <h2 class="text-4xl font-bold text-center mb-10 text-white">{t('tours.title')}</h2>
      <div class="block md:hidden">
        <ToursCarousel tours={toursEn} lang="en" t={t} />
      </div>
      <div class="hidden md:grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
        {toursEn.map(tour => (
          <TourCard tour={tour} lang="en" t={t} />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
