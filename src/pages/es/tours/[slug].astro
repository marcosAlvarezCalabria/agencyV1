---
// Página dinámica de tour individual en español
import Baselayout from '../../../layouts/Baselayout.astro';

export async function getStaticPaths() {
  const tours = (await import('../../../data/tours.es.json')).default;
  return tours.map(tour => ({ params: { slug: tour.slug } }));
}

const { slug } = Astro.params;
const tours = (await import('../../../data/tours.es.json')).default;
const tour = tours.find(t => t.slug === slug);

if (!tour) {
  throw new Error('Tour no encontrado');
}

// SEO y lang dinámico para el layout
const lang = 'es';
const seo = {
  title: `${tour.name} | Agencia Cusco`,
  description: tour.description,
  hreflangs: [
    { lang: 'es', url: `/es/tours/${slug}` },
    { lang: 'en', url: `/tours/${slug}` }
  ]
};
---
<Baselayout lang={lang} seo={seo}>
  <section class="w-full px-2 md:px-6 lg:px-10 py-10 relative overflow-hidden">
    <div class="fixed inset-0 w-full h-full -z-10" style="background: var(--bg-primary);"></div>
    <div class="tour-detail-flex">
      {/* Galería lateral solo en desktop/tablet */}
      {/* Galería única responsive (desktop y mobile) */}
      {tour.images && tour.images.length > 0 && (
        <aside
          class="flex flex-col w-full md:w-[38vw] max-w-[650px] min-w-[0] md:min-w-[320px] md:h-[85vh] md:sticky md:top-24 md:self-start md:mr-6 md:pr-2 lg:pr-4 mb-8 md:mb-0"
        >
          <div class="gallery-main-img-wrap mb-3 md:mb-3 w-full h-56 md:h-auto" style="position:relative;">
            <span id="mainImgLoader" class="img-loader-overlay"></span>
            <img id="mainTourImg" src={tour.images[0]} alt={tour.name + ' principal'} class="gallery-main-img no-rounded" loading="lazy"
              onload="this.previousElementSibling.style.display='none'" onerror="this.previousElementSibling.style.display='flex'" />
          </div>
          {tour.images.length > 1 && (
            <div id="miniCarousel" class="gallery-thumbs-row flex gap-2 overflow-x-auto pb-1 justify-center mt-2 w-full" style="scrollbar-width: none; -ms-overflow-style: none; margin-left:auto; margin-right:auto;">
              {tour.images.map((img, idx) => (
                <div class="gallery-thumb-wrap" style="position:relative;">
                  <span class="img-loader-overlay img-thumb-loader"></span>
                  <img
                    src={img}
                    alt={tour.name + ' miniatura ' + (idx+1)}
                    class="gallery-thumb-img w-16 h-16 md:w-full md:h-full object-cover border-2 border-transparent cursor-pointer transition-all duration-200 flex-shrink-0 no-rounded"
                    aria-label={`Ver imagen ${idx+1} de ${tour.images.length}`}
                    tabindex="0"
                    style={idx === 0 ? 'border:2.5px solid var(--primary-500)' : 'border:1.5px solid var(--primary-200)'}
                    loading="lazy"
                    onload="if(this.previousElementSibling) this.previousElementSibling.style.display='none';"
                    onerror="if(this.previousElementSibling) this.previousElementSibling.style.display='flex';"
                    onclick={`
                      document.getElementById('mainTourImg').src='${img}';
                      Array.from(this.parentNode.parentNode.querySelectorAll('.gallery-thumb-img')).forEach(el=>el.style.border='1.5px solid var(--primary-200)');
                      this.style.border='2.5px solid var(--primary-500)';
                      if(this.previousElementSibling) this.previousElementSibling.style.display='none';
                      document.getElementById('mainImgLoader').style.display='flex';
                      // Centrar la miniatura activa en el carrusel solo en mobile
                      if(window.innerWidth<768){
                        const carousel = document.getElementById('miniCarousel');
                        const rect = this.getBoundingClientRect();
                        const crect = carousel.getBoundingClientRect();
                        carousel.scrollBy({
                          left: rect.left - crect.left - crect.width/2 + rect.width/2,
                          behavior: 'smooth'
                        });
                      }
                    `}
                    onkeydown={`if(event.key==='Enter'||event.key===' '){this.click();}`}
                  />
                </div>
              ))}
            </div>
          )}
        </aside>
      )}
      {/* Columna de texto scrollable a la derecha */}
      <main class="tour-detail-content grow">
        <h1 class="text-3xl md:text-4xl font-extrabold mb-2" style="color: var(--earth-600);">{tour.name}</h1>
        <span class="inline-block text-white px-3 py-1 rounded-lg font-bold text-lg mb-2" style="background-color: var(--primary-500);">${tour.price}</span>
        <p class="text-lg mb-4" style="color: var(--text-primary);">{tour.description}</p>
        <div class="mb-4 flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" style="color: var(--earth-600);" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm0 10c-4.41 0-8-1.79-8-4V6c0-2.21 3.59-4 8-4s8 1.79 8 4v8c0 2.21-3.59 4-8 4z" /></svg>
          <span class="font-semibold" style="color: var(--earth-600);">Duración:</span> <span style="color: var(--text-secondary);">{tour.duration}</span>
        </div>

        <!-- Tipo y Dificultad -->
        <div class="mb-4 flex flex-wrap gap-4">
          {tour.type && (
            <div class="flex items-center gap-2">
              <span class="font-semibold" style="color: var(--earth-600);">Tipo:</span>
              <span class="px-3 py-1 bg-blue-100 text-blue-800 rounded-full text-sm font-medium">
                {tour.type}
              </span>
            </div>
          )}
          {tour.difficulty && (
            <div class="flex items-center gap-2">
              <span class="font-semibold" style="color: var(--earth-600);">Dificultad:</span>
              <span class={`px-3 py-1 rounded-full text-sm font-medium ${
                tour.difficulty === 'Fácil' ? 'bg-green-100 text-green-800' :
                tour.difficulty === 'Moderado' ? 'bg-yellow-100 text-yellow-800' :
                'bg-red-100 text-red-800'
              }`}>
                {tour.difficulty}
              </span>
            </div>
          )}
        </div>

        <!-- Lugares a visitar -->
        {tour.places_to_visit && tour.places_to_visit.length > 0 && (
          <div class="mb-4">
            <div class="flex items-center gap-2 mb-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" style="color: var(--earth-600);" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              <span class="font-semibold" style="color: var(--earth-600);">Lugares a visitar:</span>
            </div>
            <div class="flex flex-wrap gap-2">
              {tour.places_to_visit.map(place => (
                <span class="px-3 py-1 bg-amber-100 text-amber-800 rounded-full text-sm">
                  📍 {place}
                </span>
              ))}
            </div>
          </div>
        )}
        {tour.itinerary && (
          <div class="mb-4">
            <div class="flex items-center gap-2 mb-1">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" style="color: var(--earth-600);" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2a4 4 0 014-4h4m0 0V7m0 4l-4-4-4 4" /></svg>
              <span class="font-semibold" style="color: var(--earth-600);">Itinerario:</span>
            </div>
            <ul class="list-decimal list-inside" style="color: var(--text-primary);">
              {tour.itinerary.map(dia => (
                <li class="mb-1">
                  <span class="font-bold">{dia.day}:</span> <span class="italic">{dia.title}</span> – {dia.description}
                </li>
              ))}
            </ul>
          </div>
        )}
        <div class="mb-4">
          <div class="flex items-center gap-2 mb-1">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" style="color: var(--earth-600);" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            <span class="font-semibold" style="color: var(--earth-600);">Incluye:</span>
          </div>
          <ul class="list-disc list-inside" style="color: var(--text-primary);">
            {tour.includes.map(item => <li>✅ {item}</li>)}
          </ul>
        </div>
        {tour.not_included && (
          <div class="mb-4">
            <div class="flex items-center gap-2 mb-1">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" style="color: var(--earth-600);" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
              <span class="font-semibold" style="color: var(--earth-600);">No incluye:</span>
            </div>
            <ul class="list-disc list-inside text-[#372212]">
              {tour.not_included.map(item => <li>❌ {item}</li>)}
            </ul>
          </div>
        )}
        {tour.recommendations && (
          <div class="mb-4">
            <div class="flex items-center gap-2 mb-1">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" style="color: var(--earth-600);" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M12 20c4.418 0 8-1.79 8-4V6c0-2.21-3.582-4-8-4S4 3.79 4 6v10c0 2.21 3.582 4 8 4z" /></svg>
              <span class="font-semibold" style="color: var(--earth-600);">Recomendaciones:</span>
            </div>
            <ul class="list-disc list-inside text-[#372212]">
              {tour.recommendations.map(item => <li>💡 {item}</li>)}
            </ul>
          </div>
        )}

        <!-- Opciones de precio -->
        {tour.price_options && tour.price_options.length > 0 && (
          <div class="mb-6">
            <div class="flex items-center gap-2 mb-3">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" style="color: var(--earth-600);" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12c0 1.2-4.03 6-9 6s-9-4.8-9-6c0-1.2 4.03-6 9-6s9 4.8 9 6z"/></svg>
              <span class="font-semibold text-xl" style="color: var(--earth-600);">💰 Opciones de precio:</span>
            </div>
            <div class="space-y-3">
              {tour.price_options.map(option => (
                <div class="border rounded-lg p-4" style="border-color: var(--earth-200);">
                  <div class="flex justify-between items-start mb-2">
                    <h4 class="font-semibold" style="color: var(--earth-600);">
                      {option.option}
                    </h4>
                    <span class="font-bold text-lg" style="color: var(--primary-500);">
                      {option.price}
                    </span>
                  </div>
                  <p class="text-sm" style="color: var(--text-secondary);">
                    {option.description}
                  </p>
                </div>
              ))}
            </div>
          </div>
        )}

        <!-- Descuentos -->
        {tour.discounts && tour.discounts.length > 0 && (
          <div class="mb-6">
            <div class="flex items-center gap-2 mb-3">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" style="color: var(--earth-600);" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/></svg>
              <span class="font-semibold text-xl" style="color: var(--earth-600);">💰 Descuentos disponibles:</span>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
              {tour.discounts.map(discount => (
                <div class="bg-green-50 border border-green-200 rounded-lg p-3">
                  <div class="flex justify-between items-center">
                    <span class="font-medium text-green-800">{discount.type}</span>
                    <span class="font-bold text-green-900">{discount.percentage}</span>
                  </div>
                  <p class="text-sm text-green-700 mt-1">{discount.requirement}</p>
                </div>
              ))}
            </div>
          </div>
        )}

        <!-- FAQ -->
        {tour.faq && tour.faq.length > 0 && (
          <div class="mb-6">
            <div class="flex items-center gap-2 mb-3">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" style="color: var(--earth-600);" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              <span class="font-semibold text-xl" style="color: var(--earth-600);">❓ Preguntas frecuentes:</span>
            </div>
            <div class="space-y-4">
              {tour.faq.map(faq => (
                <div class="border rounded-lg p-4" style="border-color: var(--earth-200);">
                  <h4 class="font-semibold mb-2" style="color: var(--earth-600);">
                    P: {faq.question}
                  </h4>
                  <p style="color: var(--text-primary);">
                    R: {faq.answer}
                  </p>
                </div>
              ))}
            </div>
          </div>
        )}

        <!-- Información adicional -->
        {tour.additional_info && tour.additional_info.length > 0 && (
          <div class="mb-6">
            <div class="flex items-center gap-2 mb-3">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" style="color: var(--earth-600);" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              <span class="font-semibold text-xl" style="color: var(--earth-600);">ℹ️ Información adicional:</span>
            </div>
            <ul class="space-y-2" style="color: var(--text-primary);">
              {tour.additional_info.map(info => (
                <li class="flex items-start gap-2">
                  <span class="text-blue-600 mt-1">•</span>
                  <span>{info}</span>
                </li>
              ))}
            </ul>
          </div>
        )}

        <!-- Botón flotante solo icono, abajo a la izquierda -->
        <a href="/es/tours" class="fixed left-6 bottom-8 z-50 text-white font-bold p-4 rounded-full shadow-xl transition-all duration-200 flex items-center justify-center text-lg" style="background-color: var(--primary-500); box-shadow: var(--shadow-primary-lg);" onmouseover="this.style.backgroundColor = 'var(--earth-600)';" onmouseout="this.style.backgroundColor = 'var(--primary-500)';">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
        </a>
      </main>
    </div>
  </section>
</Baselayout>
<style>
  .tour-detail-flex {
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  @media (min-width: 768px) {
    .tour-detail-flex {
      flex-direction: row;
      align-items: flex-start;
      gap: 2rem;
      padding-left: 0.25rem;
      padding-right: 0.25rem;
    }
    @media (min-width: 1024px) {
      .tour-detail-flex {
        padding-left: 1rem;
        padding-right: 1rem;
      }
    }
  }
  .tour-gallery-column {
    position: sticky;
    top: 6.5rem;
    align-self: flex-start;
    max-height: 80vh;
    background: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-right: 1.5rem;
    margin-left: 0;
  }
  .gallery-main-img-wrap {
    width: 100%;
    aspect-ratio: 4/3;
    background: #fff;
    border-radius: 0;
    box-shadow: 0 2px 12px 0 rgba(166,124,0,0.08);
    border: 1.5px solid #ffe08233;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .gallery-main-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 0;
    background: #fff;
    transition: transform 0.18s;
    display: block;
    border: 1.5px solid #e5e5e5;
    box-shadow: 0 2px 8px 0 rgba(0,0,0,0.04);
  }
  .img-loader-overlay {
    display: flex;
    align-items: center;
    justify-content: center;
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    z-index: 3;
    background: rgba(255,255,255,0.7);
  }
  .img-loader-overlay:before {
    content: "";
    display: block;
    width: 54px;
    height: 54px;
    background: url('/assets/images/logoInkasTravel.png') center center no-repeat;
    background-size: contain;
    animation: logo-blink 1.2s linear infinite;
    opacity: 0.85;
  }
  .img-thumb-loader:before {
    width: 32px;
    height: 32px;
  }
  .gallery-main-img:hover {
    transform: scale(1.03);
    box-shadow: 0 4px 18px 0 rgba(166,124,0,0.13);
  }
  .gallery-thumbs-row {
    width: 100%;
    display: flex;
    flex-direction: row;
    gap: 0.5rem;
    overflow-x: auto;
    scrollbar-width: thin;
    scrollbar-color: #ffe082 #fffde7;
  }
  .gallery-thumb-wrap {
    flex: 0 0 auto;
    width: 70px;
    aspect-ratio: 1/1;
    background: #fff;
    border-radius: 0;
    box-shadow: 0 1px 6px 0 rgba(166,124,0,0.07);
    border: 1.2px solid #ffe08233;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: box-shadow 0.15s;
  }
  .gallery-thumb-wrap:hover {
    box-shadow: 0 2px 12px 0 rgba(166,124,0,0.13);
  }
  .gallery-thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 0;
    background: #fff;
    transition: transform 0.15s;
    display: block;
    border: 1.2px solid #e5e5e5;
    box-shadow: 0 1px 4px 0 rgba(0,0,0,0.03);
  }
  @keyframes logo-blink {
    0%, 100% { opacity: 0.85; }
    50% { opacity: 0.2; }
  }
  .gallery-thumb-img:hover {
    transform: scale(1.06);
  }
  .tour-detail-content {
    min-width: 0;
    width: 100%;
    max-width: 900px;
    margin-left: 0;
    margin-right: 0;
    padding-bottom: 2rem;
    overflow-y: auto;
    padding-left: 0.25rem;
    padding-right: 0.25rem;
  }
  @media (min-width: 1024px) {
    .tour-detail-content {
      padding-left: 1rem;
      padding-right: 1rem;
    }
  }
</style>
