---
import BaseLayout from '../../layouts/Baselayout.astro';
import toursEs from '../../data/tours.es.json';
import TourCard from '../../components/TourCard.astro';
import ToursCarousel from '../../components/ToursCarousel.astro';
import { useTranslations } from '../../i18n/utils';

const t = useTranslations('es');
const seo = {
  title: 'Nuestros Tours | Agencia Cusco',
  description: 'Descubre nuestros mejores tours en Cusco y Perú. Aventura, cultura y más con Agencia Cusco.',
  hreflangs: [
    { lang: 'en', url: '/en/tours' },
    { lang: 'es', url: '/es/tours' }
  ]
};
---

<BaseLayout lang="es" t={t} seo={seo}>
  <section id="tours" class="py-16 px-4 glassmorphism">
    <div class="container mx-auto">
      <h2 class="text-4xl font-bold text-center mb-10" style="color: #3d1f14;">{t('tours.title')}</h2>

      <!-- Mobile: Carousel -->
      <div class="block md:hidden">
        <ToursCarousel tours={toursEs} lang="es" t={t} />
      </div>

      <!-- Desktop: Grid con 3 columnas -->
      <div class="hidden md:grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {toursEs.map(tour => (
          <TourCard tour={tour} lang="es" t={t} />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
/* Line clamp para texto */
.line-clamp-2 {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
</style>
