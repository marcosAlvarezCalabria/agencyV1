---
// Página dinámica de tour individual
import Baselayout from '../../layouts/Baselayout.astro';
import TourGallerySlider from '../../components/TourGallerySlider.astro';

export async function getStaticPaths() {
  const tours = (await import('../../data/tours.en.json')).default;
  return tours.map(tour => ({ params: { slug: tour.slug } }));
}

const { slug } = Astro.params;
const tours = (await import('../../data/tours.en.json')).default;
const tour = tours.find(t => t.slug === slug);

if (!tour) {
  throw new Error('Tour not found');
}

// SEO y lang dinámico para el layout
// Variables auxiliares (NO Astro.props)
const lang = 'en';
const seo = {
  title: `${tour.name} | Agencia Cusco`,
  description: tour.description,
  hreflangs: [
    { lang: 'en', url: `/tours/${slug}` },
    { lang: 'es', url: `/es/tours/${slug}` }
  ]
};
---
<Baselayout lang={lang} seo={seo}>
  <!-- Joystick de navegación flotante -->
  <div class="fixed bottom-6 right-6 z-50 flex flex-col gap-2">
    <!-- Botón subir arriba -->
    <button
      id="scroll-to-top"
      class="flex items-center justify-center w-9 h-9 rounded-full shadow-md transition-all duration-300 hover:scale-110 hover:shadow-lg opacity-0 pointer-events-none"
      style="background: linear-gradient(135deg, #d2a530 0%, #a67c00 100%);"
      title="Scroll to top"
    >
      <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 10l7-7m0 0l7 7m-7-7v18"/>
      </svg>
    </button>

    <!-- Botón volver atrás -->
    <a
      href="/tours"
      class="flex items-center justify-center w-9 h-9 rounded-full shadow-md transition-all duration-300 hover:scale-110 hover:shadow-lg group"
      style="background: linear-gradient(135deg, #b64926 0%, #8a3619 100%);"
      title="Back to tours"
    >
      <svg class="w-4 h-4 text-white transition-transform duration-300 group-hover:-translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"/>
      </svg>
    </a>
  </div>

  <script>
    // Scroll to top functionality
    const scrollBtn = document.getElementById('scroll-to-top');

    window.addEventListener('scroll', () => {
      if (window.scrollY > 300) {
        scrollBtn?.classList.remove('opacity-0', 'pointer-events-none');
        scrollBtn?.classList.add('opacity-100');
      } else {
        scrollBtn?.classList.add('opacity-0', 'pointer-events-none');
        scrollBtn?.classList.remove('opacity-100');
      }
    });

    scrollBtn?.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  </script>

  <!-- Contenedor principal con fondo blanco -->
  <div class="min-h-screen bg-white">
    <section class="container mx-auto px-4 py-8">
      <div class="flex flex-col md:flex-row gap-8 items-center md:items-start">
        <!-- Imagen del tour -->
        <img 
          src={tour.image} 
          alt={tour.name} 
          class="w-full md:w-80 rounded-xl shadow-lg border-2 bg-white" 
          style="border-color: var(--primary-500);" 
          loading="lazy" 
        />
        
        <!-- Contenido del tour -->
        <div class="flex-1">
          <!-- Galería de fotos -->
          <TourGallerySlider tourSlug={tour.slug} tourName={tour.name} />

          <!-- Título -->
          <h1 
            class="text-3xl md:text-4xl font-extrabold mb-2" 
            style="color: var(--earth-600);"
          >
            {tour.name}
          </h1>
          
          <!-- Precio -->
          <span 
            class="inline-block text-white px-3 py-1 rounded-lg font-bold text-lg mb-2" 
            style="background-color: var(--primary-500);"
          >
            ${tour.price}
          </span>
          
          <!-- Descripción -->
          <p 
            class="text-lg mb-4" 
            style="color: var(--text-primary);"
          >
            {tour.description}
          </p>
          
          <!-- Duración -->
          <div class="mb-4">
            <span 
              class="font-semibold" 
              style="color: var(--earth-600);"
            >
              Duration:
            </span> 
            <span style="color: var(--text-secondary);">{tour.duration}</span>
          </div>
          
          <!-- Tipo y Dificultad -->
          <div class="mb-4 flex gap-4">
            {tour.type && (
              <div>
                <span class="font-semibold" style="color: var(--earth-600);">Type:</span>
                <span class="ml-2 px-3 py-1 bg-blue-100 text-blue-800 rounded-full text-sm font-medium">
                  {tour.type}
                </span>
              </div>
            )}
            {tour.difficulty && (
              <div>
                <span class="font-semibold" style="color: var(--earth-600);">Difficulty:</span>
                <span class={`ml-2 px-3 py-1 rounded-full text-sm font-medium ${
                  tour.difficulty === 'Easy' ? 'bg-green-100 text-green-800' :
                  tour.difficulty === 'Moderate' ? 'bg-yellow-100 text-yellow-800' :
                  'bg-red-100 text-red-800'
                }`}>
                  {tour.difficulty}
                </span>
              </div>
            )}
          </div>

          <!-- Lugares a visitar -->
          {tour.places_to_visit && tour.places_to_visit.length > 0 && (
            <div class="mb-4">
              <span class="font-semibold" style="color: var(--earth-600);">
                Places to visit:
              </span>
              <div class="flex flex-wrap gap-2 mt-2">
                {tour.places_to_visit.map(place => (
                  <span class="px-3 py-1 bg-amber-100 text-amber-800 rounded-full text-sm">
                    📍 {place}
                  </span>
                ))}
              </div>
            </div>
          )}

          <!-- Incluye -->
          <div class="mb-4">
            <span
              class="font-semibold"
              style="color: var(--earth-600);"
            >
              Includes:
            </span>
            <ul
              class="list-disc list-inside mt-2"
              style="color: var(--text-primary);"
            >
              {tour.includes.map(item => <li>✅ {item}</li>)}
            </ul>
          </div>

          <!-- No incluye -->
          {tour.not_included && tour.not_included.length > 0 && (
            <div class="mb-4">
              <span class="font-semibold" style="color: var(--earth-600);">
                Not included:
              </span>
              <ul class="list-disc list-inside mt-2" style="color: var(--text-primary);">
                {tour.not_included.map(item => <li>❌ {item}</li>)}
              </ul>
            </div>
          )}

          <!-- Itinerario detallado -->
          {tour.itinerary && tour.itinerary.length > 0 && (
            <div class="mb-6">
              <h3 class="text-xl font-bold mb-3" style="color: var(--earth-600);">
                Itinerary:
              </h3>
              <div class="space-y-4">
                {tour.itinerary.map(day => (
                  <div class="border rounded-lg p-4" style="border-color: var(--earth-200);">
                    <h4 class="font-semibold text-lg mb-2" style="color: var(--earth-600);">
                      {day.day}: {day.title}
                    </h4>
                    {day.activities && (
                      <ul class="space-y-1" style="color: var(--text-primary);">
                        {day.activities.map(activity => (
                          <li class="flex items-start gap-2">
                            <span class="text-green-600 mt-1">•</span>
                            <span>{activity}</span>
                          </li>
                        ))}
                      </ul>
                    )}
                  </div>
                ))}
              </div>
            </div>
          )}

          <!-- Opciones de precio -->
          {tour.price_options && tour.price_options.length > 0 && (
            <div class="mb-6">
              <h3 class="text-xl font-bold mb-3" style="color: var(--earth-600);">
                Price Options:
              </h3>
              <div class="space-y-3">
                {tour.price_options.map(option => (
                  <div class="border rounded-lg p-4" style="border-color: var(--earth-200);">
                    <div class="flex justify-between items-start mb-2">
                      <h4 class="font-semibold" style="color: var(--earth-600);">
                        {option.option}
                      </h4>
                      <span class="font-bold text-lg" style="color: var(--primary-500);">
                        {option.price}
                      </span>
                    </div>
                    <p class="text-sm" style="color: var(--text-secondary);">
                      {option.description}
                    </p>
                  </div>
                ))}
              </div>
            </div>
          )}

          <!-- Descuentos -->
          {tour.discounts && tour.discounts.length > 0 && (
            <div class="mb-6">
              <h3 class="text-xl font-bold mb-3" style="color: var(--earth-600);">
                💰 Available Discounts:
              </h3>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                {tour.discounts.map(discount => (
                  <div class="bg-green-50 border border-green-200 rounded-lg p-3">
                    <div class="flex justify-between items-center">
                      <span class="font-medium text-green-800">{discount.type}</span>
                      <span class="font-bold text-green-900">{discount.percentage}</span>
                    </div>
                    <p class="text-sm text-green-700 mt-1">{discount.requirement}</p>
                  </div>
                ))}
              </div>
            </div>
          )}

          <!-- FAQ -->
          {tour.faq && tour.faq.length > 0 && (
            <div class="mb-6">
              <h3 class="text-xl font-bold mb-3" style="color: var(--earth-600);">
                ❓ Frequently Asked Questions:
              </h3>
              <div class="space-y-4">
                {tour.faq.map(faq => (
                  <div class="border rounded-lg p-4" style="border-color: var(--earth-200);">
                    <h4 class="font-semibold mb-2" style="color: var(--earth-600);">
                      Q: {faq.question}
                    </h4>
                    <p style="color: var(--text-primary);">
                      A: {faq.answer}
                    </p>
                  </div>
                ))}
              </div>
            </div>
          )}

          <!-- Información adicional -->
          {tour.additional_info && tour.additional_info.length > 0 && (
            <div class="mb-6">
              <h3 class="text-xl font-bold mb-3" style="color: var(--earth-600);">
                ℹ️ Additional Information:
              </h3>
              <ul class="space-y-2" style="color: var(--text-primary);">
                {tour.additional_info.map(info => (
                  <li class="flex items-start gap-2">
                    <span class="text-blue-600 mt-1">•</span>
                    <span>{info}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}

        </div>
      </div>
    </section>
  </div>
</Baselayout>
