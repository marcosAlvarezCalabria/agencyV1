---
// Página dinámica de tour individual
import Baselayout from '../../layouts/Baselayout.astro';
import TourGallery from '../../components/TourGallery.astro';

export async function getStaticPaths() {
  const tours = (await import('../../data/tours.en.json')).default;
  return tours.map(tour => ({ params: { slug: tour.slug } }));
}

const { slug } = Astro.params;
const tours = (await import('../../data/tours.en.json')).default;
const tour = tours.find(t => t.slug === slug);

if (!tour) {
  throw new Error('Tour not found');
}

// SEO y lang dinámico para el layout
// Variables auxiliares (NO Astro.props)
const lang = 'en';
const seo = {
  title: `${tour.name} | Agencia Cusco`,
  description: tour.description,
  hreflangs: [
    { lang: 'en', url: `/tours/${slug}` },
    { lang: 'es', url: `/es/tours/${slug}` }
  ]
};
---
<Baselayout lang={lang} seo={seo}>
  <!-- Contenedor principal con fondo claro -->
  <div class="min-h-screen" style="background-color: var(--bg-primary);">
    <section class="container mx-auto px-4 py-8">
      <div class="flex flex-col md:flex-row gap-8 items-center md:items-start">
        <!-- Imagen del tour -->
        <img 
          src={tour.image} 
          alt={tour.name} 
          class="w-full md:w-80 rounded-xl shadow-lg border-2 bg-white" 
          style="border-color: var(--primary-500);" 
          loading="lazy" 
        />
        
        <!-- Contenido del tour -->
        <div class="flex-1">
          <!-- Galería de fotos -->
          {tour.images && tour.images.length > 0 && (
            <TourGallery images={tour.images} tourName={tour.name} />
          )}

          <!-- Título -->
          <h1 
            class="text-3xl md:text-4xl font-extrabold mb-2" 
            style="color: var(--earth-600);"
          >
            {tour.name}
          </h1>
          
          <!-- Precio -->
          <span 
            class="inline-block text-white px-3 py-1 rounded-lg font-bold text-lg mb-2" 
            style="background-color: var(--primary-500);"
          >
            ${tour.price}
          </span>
          
          <!-- Descripción -->
          <p 
            class="text-lg mb-4" 
            style="color: var(--text-primary);"
          >
            {tour.description}
          </p>
          
          <!-- Duración -->
          <div class="mb-4">
            <span 
              class="font-semibold" 
              style="color: var(--earth-600);"
            >
              Duration:
            </span> 
            <span style="color: var(--text-secondary);">{tour.duration}</span>
          </div>
          
          <!-- Tipo y Dificultad -->
          <div class="mb-4 flex gap-4">
            {tour.type && (
              <div>
                <span class="font-semibold" style="color: var(--earth-600);">Type:</span>
                <span class="ml-2 px-3 py-1 bg-blue-100 text-blue-800 rounded-full text-sm font-medium">
                  {tour.type}
                </span>
              </div>
            )}
            {tour.difficulty && (
              <div>
                <span class="font-semibold" style="color: var(--earth-600);">Difficulty:</span>
                <span class={`ml-2 px-3 py-1 rounded-full text-sm font-medium ${
                  tour.difficulty === 'Easy' ? 'bg-green-100 text-green-800' :
                  tour.difficulty === 'Moderate' ? 'bg-yellow-100 text-yellow-800' :
                  'bg-red-100 text-red-800'
                }`}>
                  {tour.difficulty}
                </span>
              </div>
            )}
          </div>

          <!-- Lugares a visitar -->
          {tour.places_to_visit && tour.places_to_visit.length > 0 && (
            <div class="mb-4">
              <span class="font-semibold" style="color: var(--earth-600);">
                Places to visit:
              </span>
              <div class="flex flex-wrap gap-2 mt-2">
                {tour.places_to_visit.map(place => (
                  <span class="px-3 py-1 bg-amber-100 text-amber-800 rounded-full text-sm">
                    📍 {place}
                  </span>
                ))}
              </div>
            </div>
          )}

          <!-- Incluye -->
          <div class="mb-4">
            <span
              class="font-semibold"
              style="color: var(--earth-600);"
            >
              Includes:
            </span>
            <ul
              class="list-disc list-inside mt-2"
              style="color: var(--text-primary);"
            >
              {tour.includes.map(item => <li>✅ {item}</li>)}
            </ul>
          </div>

          <!-- No incluye -->
          {tour.not_included && tour.not_included.length > 0 && (
            <div class="mb-4">
              <span class="font-semibold" style="color: var(--earth-600);">
                Not included:
              </span>
              <ul class="list-disc list-inside mt-2" style="color: var(--text-primary);">
                {tour.not_included.map(item => <li>❌ {item}</li>)}
              </ul>
            </div>
          )}

          <!-- Itinerario detallado -->
          {tour.itinerary && tour.itinerary.length > 0 && (
            <div class="mb-6">
              <h3 class="text-xl font-bold mb-3" style="color: var(--earth-600);">
                Itinerary:
              </h3>
              <div class="space-y-4">
                {tour.itinerary.map(day => (
                  <div class="border rounded-lg p-4" style="border-color: var(--earth-200);">
                    <h4 class="font-semibold text-lg mb-2" style="color: var(--earth-600);">
                      {day.day}: {day.title}
                    </h4>
                    {day.activities && (
                      <ul class="space-y-1" style="color: var(--text-primary);">
                        {day.activities.map(activity => (
                          <li class="flex items-start gap-2">
                            <span class="text-green-600 mt-1">•</span>
                            <span>{activity}</span>
                          </li>
                        ))}
                      </ul>
                    )}
                  </div>
                ))}
              </div>
            </div>
          )}

          <!-- Opciones de precio -->
          {tour.price_options && tour.price_options.length > 0 && (
            <div class="mb-6">
              <h3 class="text-xl font-bold mb-3" style="color: var(--earth-600);">
                Price Options:
              </h3>
              <div class="space-y-3">
                {tour.price_options.map(option => (
                  <div class="border rounded-lg p-4" style="border-color: var(--earth-200);">
                    <div class="flex justify-between items-start mb-2">
                      <h4 class="font-semibold" style="color: var(--earth-600);">
                        {option.option}
                      </h4>
                      <span class="font-bold text-lg" style="color: var(--primary-500);">
                        {option.price}
                      </span>
                    </div>
                    <p class="text-sm" style="color: var(--text-secondary);">
                      {option.description}
                    </p>
                  </div>
                ))}
              </div>
            </div>
          )}

          <!-- Descuentos -->
          {tour.discounts && tour.discounts.length > 0 && (
            <div class="mb-6">
              <h3 class="text-xl font-bold mb-3" style="color: var(--earth-600);">
                💰 Available Discounts:
              </h3>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                {tour.discounts.map(discount => (
                  <div class="bg-green-50 border border-green-200 rounded-lg p-3">
                    <div class="flex justify-between items-center">
                      <span class="font-medium text-green-800">{discount.type}</span>
                      <span class="font-bold text-green-900">{discount.percentage}</span>
                    </div>
                    <p class="text-sm text-green-700 mt-1">{discount.requirement}</p>
                  </div>
                ))}
              </div>
            </div>
          )}

          <!-- FAQ -->
          {tour.faq && tour.faq.length > 0 && (
            <div class="mb-6">
              <h3 class="text-xl font-bold mb-3" style="color: var(--earth-600);">
                ❓ Frequently Asked Questions:
              </h3>
              <div class="space-y-4">
                {tour.faq.map(faq => (
                  <div class="border rounded-lg p-4" style="border-color: var(--earth-200);">
                    <h4 class="font-semibold mb-2" style="color: var(--earth-600);">
                      Q: {faq.question}
                    </h4>
                    <p style="color: var(--text-primary);">
                      A: {faq.answer}
                    </p>
                  </div>
                ))}
              </div>
            </div>
          )}

          <!-- Información adicional -->
          {tour.additional_info && tour.additional_info.length > 0 && (
            <div class="mb-6">
              <h3 class="text-xl font-bold mb-3" style="color: var(--earth-600);">
                ℹ️ Additional Information:
              </h3>
              <ul class="space-y-2" style="color: var(--text-primary);">
                {tour.additional_info.map(info => (
                  <li class="flex items-start gap-2">
                    <span class="text-blue-600 mt-1">•</span>
                    <span>{info}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}

          <!-- Botón de regreso -->
          <div class="flex gap-4 mt-6">
            <a 
              href="/tours" 
              class="inline-flex items-center gap-2 px-4 py-2 rounded-lg font-medium transition-all duration-300 hover:scale-105"
              style="
                color: var(--earth-600); 
                background-color: var(--earth-50);
                border: 1px solid var(--earth-200);
              "
              onmouseover="this.style.backgroundColor = 'var(--earth-100)'; this.style.color = 'var(--earth-700)';"
              onmouseout="this.style.backgroundColor = 'var(--earth-50)'; this.style.color = 'var(--earth-600)';"
            >
              <svg width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                <path fill-rule="evenodd" d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8z"/>
              </svg>
              Back to tours
            </a>
            
            <!-- Botón de WhatsApp -->
            <a 
              href={`https://wa.me/51984302905?text=Hola%2C%20me%20interesa%20el%20tour%20${encodeURIComponent(tour.name)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-6 py-2 rounded-lg font-bold transition-all duration-300 hover:scale-105 text-white"
              style="background-color: var(--success-500);"
              onmouseover="this.style.backgroundColor = 'var(--success-600)';"
              onmouseout="this.style.backgroundColor = 'var(--success-500)';"
            >
              <svg width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                <path d="M13.601 2.326A7.854 7.854 0 0 0 7.994 0C3.627 0 .068 3.558.064 7.926c0 1.399.366 2.76 1.057 3.965L0 16l4.204-1.102a7.933 7.933 0 0 0 3.79.965h.004c4.368 0 7.926-3.558 7.93-7.93A7.898 7.898 0 0 0 13.6 2.326zM7.994 14.521a6.573 6.573 0 0 1-3.356-.92l-.24-.144-2.494.654.666-2.433-.156-.251a6.56 6.56 0 0 1-1.007-3.505c0-3.626 2.957-6.584 6.591-6.584a6.56 6.56 0 0 1 4.66 1.931 6.557 6.557 0 0 1 1.928 4.66c-.004 3.639-2.961 6.592-6.592 6.592zm3.615-4.934c-.197-.099-1.17-.578-1.353-.646-.182-.065-.315-.099-.445.099-.133.197-.513.646-.627.784-.114.133-.232.148-.43.05-.197-.1-.836-.308-1.592-.985-.59-.525-.985-1.175-1.103-1.372-.114-.198-.011-.304.088-.403.087-.088.197-.232.296-.346.1-.114.133-.198.198-.33.065-.134.034-.248-.015-.347-.05-.099-.445-1.076-.612-1.47-.16-.389-.323-.336-.445-.342-.114-.007-.247-.007-.38-.007a.729.729 0 0 0-.529.247c-.182.198-.691.677-.691 1.654 0 .977.71 1.916.81 2.049.098.133 1.394 2.132 3.383 2.992.47.205.84.326 1.129.418.475.152.904.129 1.246.08.38-.058 1.171-.48 1.338-.943.164-.464.164-.86.114-.943-.049-.084-.182-.133-.38-.232z"/>
              </svg>
              Book via WhatsApp
            </a>
          </div>
        </div>
      </div>
    </section>
  </div>
</Baselayout>
